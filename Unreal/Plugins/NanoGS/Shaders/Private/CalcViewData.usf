//Purpose: Transform 3D splat data → 2D screen-space data

#include "/Plugin/NanoGS/Private/GaussianSplatting.ush"

// Shader parameters
ByteAddressBuffer PackedSplatBuffer;  // 16 bytes/splat packed data
ByteAddressBuffer SHBuffer;           // SH data (currently unused)
RWStructuredBuffer<FGaussianSplatViewData> ViewDataBuffer; //pass calculated result to ViewDataBuffer

// Cluster visibility integration (UNIFIED APPROACH)
// SplatClusterIndexBuffer maps ALL splats (original + LOD) to their cluster
// - Original splats (index < OriginalSplatCount) -> leaf cluster ID
// - LOD splats (index >= OriginalSplatCount) -> parent cluster ID
StructuredBuffer<uint> SplatClusterIndexBuffer;
StructuredBuffer<uint> ClusterVisibilityBitmap;       // Leaf cluster visibility
StructuredBuffer<uint> LODClusterSelectedBitmap;      // Parent cluster LOD selection
StructuredBuffer<uint> SelectedClusterBuffer;  // Maps leaf cluster -> selected cluster for debug viz
uint UseClusterCulling;  // 1 = check visibility, 0 = process all splats
uint UseLODRendering;    // 1 = enable LOD rendering (unified approach)
uint OriginalSplatCount; // Count of original splats (LOD splats start after this)

// Compaction mode: process only visible splats from CompactedSplatIndices
StructuredBuffer<uint> CompactedSplatIndices;  // Indices of visible splats
uint UseCompaction;      // 1 = use compacted indices (skip visibility checks)
uint VisibleSplatCount;  // Number of visible splats (when using compaction)

float4x4 LocalToWorld;
float4x4 WorldToPLY;   // Transforms world direction to PLY/SH space for SH evaluation
float4x4 WorldToClip;
float4x4 WorldToView;
float4x4 ViewToWorld;
float3 PreViewTranslation;  // For translating world position (velocity calculation)
float3 CameraPosition;
float2 ScreenSize;
float2 FocalLength;
uint SplatCount;
uint SHOrder;
uint NumSHCoeffs;      // Coefficients to evaluate (based on SHOrder: 4, 9, or 16)
uint SHBufferCoeffs;   // Coefficients actually stored per splat in SHBuffer (based on asset SHBands)
uint UseSHRendering;   // 1 = use view-dependent SH evaluation, 0 = use pre-computed DC color
float OpacityScale;
float SplatScale;
float QuadInflation;   // GEER: multiply EWA quad axes (footprint only); 1.0 = off
uint  UseGeerEval;     // 1 = fill W2O rows / AA opacity (ViewDistance is always filled)
uint  UseNativeGeer;   // 1 = full-output native raymap path; no pinhole projection/culling
StructuredBuffer<uint4> NativeGeerInverseDirection;
int2 NativeGeerInverseGrid;
int2 NativeGeerOutputSize;
float3 NativeGeerCommonOriginCameraCm;
uint NativeGeerCandidateMode; // 0 = full-output oracle, 1 = bounded-bin conservative rectangle
uint NativeGeerNearCullAxial; // 1 = GeerNearCull is axial from the apex, 0 = Euclidean from it
float GeerNearCull;    // GEER: cull splats nearer than this distance (cm); 0 = off
uint  UseGeerPBF;      // 1 = replace the EWA quad with the exact PBF rect (gs.GeerPBF)
float GeerPBFLambda;   // PBF bound radius in sigma (follows gs.GeerCutoff; 3.0 when it is off)
uint  UseGeerAAOpacity; // diagnostic (gs.GeerAAOpacity): GEER antialiasing opacity scaling on/off
uint GlobalBaseOffset; // Offset into global ViewDataBuffer (for multi-proxy global accumulator, non-compaction path)

// Global compaction path: read per-proxy base offset from GPU prefix-sum buffer
StructuredBuffer<uint> GlobalBaseOffsetsBuffer; // [MAX_PROXY_COUNT+1] prefix sums
uint ProxyIndex;             // Index of this proxy in the global array
uint UseGlobalCompactionPath; // 1 = read offset from GlobalBaseOffsetsBuffer[ProxyIndex]
uint MaxRenderBudget; // Budget cap: skip writes at indices >= this value (0 = no cap)

// Check if a leaf cluster is visible using the visibility bitmap
bool IsClusterVisible(uint clusterIndex)
{
	uint bitmapIndex = clusterIndex / 32;
	uint bitMask = 1u << (clusterIndex % 32);
	return (ClusterVisibilityBitmap[bitmapIndex] & bitMask) != 0;
}

// Check if a parent cluster is selected for LOD rendering
bool IsLODClusterSelected(uint clusterIndex)
{
	uint bitmapIndex = clusterIndex / 32;
	uint bitMask = 1u << (clusterIndex % 32);
	return (LODClusterSelectedBitmap[bitmapIndex] & bitMask) != 0;
}

// Helper: write an invalid (culled) splat into ViewDataBuffer
void WriteInvalidSplat(uint outputIndex, uint clusterID, uint lodLevel)
{
	FGaussianSplatViewData viewData;
	viewData.ClipPosition = float4(0, 0, 0, -1);
	viewData.TranslatedWorldPos = float3(0, 0, 0);
	viewData.TranslatedWorldPosPad = 0;
	viewData.PackedColorRG = 0;
	viewData.PackedColorBA = 0;
	viewData.Axis1 = float2(0, 0);
	viewData.Axis2 = float2(0, 0);
	viewData.ClusterID = clusterID;
	viewData.Padding = lodLevel;
	viewData.SplatNormal = float3(0, 0, 0);
	viewData.SplatNormalConfidence = 0;
	viewData.W2ORow0 = float3(0, 0, 0);
	viewData.ViewDistance = 0;
	viewData.W2ORow1 = float3(0, 0, 0);
	viewData.W2OPad1 = 0;
	viewData.W2ORow2 = float3(0, 0, 0);
	viewData.W2OPad2 = 0;
	ViewDataBuffer[outputIndex] = viewData;
}

// Core: transform a single splat to screen space and write to ViewDataBuffer
void ProcessSplat(uint splatIndex, uint outputIndex, uint selectedClusterID, uint selectedLODLevel)
{
	// Unpack splat data from packed buffer
	FUnpackedSplat splat = UnpackSplat(PackedSplatBuffer, splatIndex);

	float3 localPos = splat.Position;
	float4 rotation = splat.Rotation;
	float3 scale = splat.Scale * SplatScale;
	float4 colorOpacity = splat.ColorOpacity;
	float opacity = colorOpacity.a * OpacityScale;

	// Transform to world space
	float4 worldPos = mul(float4(localPos, 1.0), LocalToWorld);
	float4 clipPos = mul(worldPos, WorldToClip);

	// Store translated world position for velocity calculation in pixel shader
	// TranslatedWorld = World + PreViewTranslation (matches UE convention)
	float3 translatedWorldPos = worldPos.xyz + PreViewTranslation;

	// Pinhole-only rejection. Native cameras may contain valid rays whose forward component is
	// negative, so clip-W cannot participate in native candidate generation.
	if (UseNativeGeer == 0 && clipPos.w <= 0.0)
	{
		WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
		return;
	}

	// Transform to view space
	float4 viewPos = mul(worldPos, WorldToView);

	// GEER near cull (gs.GeerNearCull), mirroring the reference's in_frustum near_threshold
	// (auxiliary.h, default 0.2 m). A splat this close degenerates under peak-density
	// evaluation: p -> 0 makes |d_obj x p_obj| -> 0, so power -> 0 across the WHOLE quad and
	// the splat renders at full opacity everywhere. The reference drops these rather than
	// shading them. GEER splats only — the classic EWA path is bit-identical without this,
	// because its falloff is in quad-local coords and decays regardless of proximity.
	//
	// WHAT distance is measured is not free. The reference measures view-space z, a HALF-SPACE;
	// measuring Euclidean range instead gives a BALL, and since r >= |z| the ball sits strictly
	// inside the slab — so an off-axis splat 5 cm from the camera clears a 20 cm Euclidean cull
	// and arrives as an opaque sheet the reference never drew. Axial is only a distance while
	// every ray points forward though, so which one applies is decided on the CPU (per camera,
	// from the raymap, overridable by gs.GeerNearCullMode) and arrives already resolved.
	float3 originView = float3(0.0, 0.0, 0.0);
	if (UseNativeGeer != 0)
	{
		// The raymap origin is in Unreal camera axes (+X forward,+Y right,+Z up). UE view axes
		// are (right,up,forward), matching the exact native PS conversion.
		originView = float3(NativeGeerCommonOriginCameraCm.y,
		                    NativeGeerCommonOriginCameraCm.z,
		                    NativeGeerCommonOriginCameraCm.x);
	}
	float3 nativeRayOrigin = CameraPosition + mul(float4(originView, 0.0), ViewToWorld).xyz;
	float nativeViewDistance = length(worldPos.xyz - nativeRayOrigin);
	// Both measured from the SAME apex, which is the whole point of ADR-001's common origin: the
	// axial form is viewPos.z shifted by the apex's own forward offset, not raw viewPos.z. On the
	// pinhole path originView is zero and NativeGeerNearCullAxial is 0, so this reduces literally
	// to the previous `viewPos.z <= GeerNearCull` — bit-identical, as Gate F requires.
	float nearCullDistance = (UseNativeGeer != 0 && NativeGeerNearCullAxial == 0)
		? nativeViewDistance
		: (viewPos.z - originView.z);
	if (UseGeerEval != 0 && GeerNearCull > 0.0 && nearCullDistance <= GeerNearCull)
	{
		WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
		return;
	}

	// Calculate covariance
	float3x3 cov3D_local = CalcCovariance3D(rotation, scale);
	float3x3 localToWorldRot = (float3x3)LocalToWorld;
	float3x3 cov3D_world = mul(transpose(localToWorldRot), mul(cov3D_local, localToWorldRot));

	// Analytic per-splat normal (GeometryMode 2): the splat's thinnest local axis, transformed to
	// world space and oriented toward the camera so that alpha-weighted accumulation across many
	// overlapping splats (GaussianSplatRendering.usf) reinforces instead of cancelling out.
	float3 splatNormal = normalize(mul(CalcSplatLocalNormal(rotation, scale), localToWorldRot));
	float3 toCamera = CameraPosition - worldPos.xyz;
	if (dot(splatNormal, toCamera) < 0.0)
	{
		splatNormal = -splatNormal;
	}
	float splatNormalConfidence = CalcSplatNormalConfidence(scale);

	// --- GEER exact ray evaluation (gs.GeerEval) ---
	// Euclidean sort key: always filled so CalcDistances can sort by it in both modes.
	float viewDistance = nativeViewDistance;
	// World-space canonical transform w2o (forward.cu:888-890). The GEER density
	// |d_obj x p_obj|^2 / |d_obj|^2 is invariant under rigid transforms + uniform
	// scale, so evaluating in UE world space (cm) is exact as long as the actor
	// scale is uniform (warned C++-side; non-uniform scale is unsupported).
	float3 w2oRow0 = 0, w2oRow1 = 0, w2oRow2 = 0;
	float3 geerSigmaEff = float3(0.0, 0.0, 0.0);
	if (UseGeerEval)
	{
		float3x3 R = QuatToMatrix(rotation);
		// Actor uniform scale factor: length of any rotated unit vector.
		float actorScale = length(mul(float3(1, 0, 0), localToWorldRot));
		// h_var = 1e-7 m^2 (GEER omni_hvar, forward.cu:154-170) = 1e-3 cm^2 in UE units.
		// Also regularizes packed 8-bit scales that decode to exactly 0.
		// Shared with the PBF bound (ComputePBFPinhole) — both must use the same effective sigma.
		const float H_VAR = GEER_H_VAR;
		float3 sw = scale * actorScale;                       // world sigma per axis (cm)
		float3 sigmaEff = sqrt(sw * sw + H_VAR);
		geerSigmaEff = sigmaEff;
		// Splat local axis j is COLUMN j of R (see CalcSplatLocalNormal).
		float3 ax0 = normalize(mul(float3(R[0][0], R[1][0], R[2][0]), localToWorldRot));
		float3 ax1 = normalize(mul(float3(R[0][1], R[1][1], R[2][1]), localToWorldRot));
		float3 ax2 = normalize(mul(float3(R[0][2], R[1][2], R[2][2]), localToWorldRot));
		w2oRow0 = ax0 / sigmaEff.x;
		w2oRow1 = ax1 / sigmaEff.y;
		w2oRow2 = ax2 / sigmaEff.z;
		// GEER antialiasing opacity scaling (forward.cu omni_hvar): ~1 except thin splats.
		// Must happen before opacity is packed into PackedColorBA below.
		// gs.GeerAAOpacity 0 disables it — diagnostic only, see NanoGS.cpp.
		if (UseGeerAAOpacity != 0)
		{
			opacity *= (sw.x * sw.y * sw.z) / (sigmaEff.x * sigmaEff.y * sigmaEff.z);
		}
	}

	float2 axis1 = float2(1.0, 0.0);
	float2 axis2 = float2(0.0, 1.0);
	float2 pbfNdcOffset = float2(0.0, 0.0);

	if (UseNativeGeer != 0)
	{
		// Mode 0 preserves the Gate-B full-output oracle. Mode 1 below replaces these defaults
		// with one conservative pixel-edge-aligned rectangle from the selected raymap lookup.
		clipPos = float4(0.0, 0.0, 0.5, 1.0);
		axis1 = float2(1.0, 0.0);
		axis2 = float2(0.0, 1.0);
		float3 cameraToCenter = worldPos.xyz - nativeRayOrigin;
		float3 centerObj = float3(dot(cameraToCenter, w2oRow0),
			                         dot(cameraToCenter, w2oRow1),
			                         dot(cameraToCenter, w2oRow2));
		// Same lambda-sigma camera-inside rule as the PBF path. A centre that encloses the camera
		// would otherwise paint the complete native output at near-peak opacity.
		if (dot(centerObj, centerObj) <= GeerPBFLambda * GeerPBFLambda)
		{
			WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
			return;
		}

		if (NativeGeerCandidateMode == 1)
		{
			if (NativeGeerInverseGrid.x <= 0 || NativeGeerInverseGrid.y <= 0 ||
				NativeGeerOutputSize.x <= 0 || NativeGeerOutputSize.y <= 0)
			{
				WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
				return;
			}

			float sphereRadius = GeerPBFLambda * max(geerSigmaEff.x,
				max(geerSigmaEff.y, geerSigmaEff.z));
			// If the conservative sphere contains the common origin while the exact ellipsoid rule
			// above did not cull, retain the diagnostic full-domain fallback. No tangent cone exists.
			if (!(nativeViewDistance <= sphereRadius))
			{
				float3 centerView = mul(float4(cameraToCenter, 0.0), WorldToView).xyz;
				float3 coneDirectionCamera = normalize(float3(
					centerView.z, centerView.x, centerView.y));
				float coneHalfAngle = asin(clamp(sphereRadius / nativeViewDistance, 0.0, 1.0));

				const float PI = 3.14159265358979323846;
				float longitudeStep = (2.0 * PI) / (float)NativeGeerInverseGrid.x;
				float latitudeStep = PI / (float)NativeGeerInverseGrid.y;
				float halfLongitude = 0.5 * longitudeStep;
				float halfLatitude = 0.5 * latitudeStep;
				// On the unit sphere, equirectangular cell distance is no greater than the planar
				// longitude/latitude diagonal. This global bound is deliberately broad at the poles.
				float cellHalfDiagonal = sqrt(
					halfLongitude * halfLongitude + halfLatitude * halfLatitude);
				float paddedHalfAngle = min(PI, coneHalfAngle + cellHalfDiagonal + 1.0e-5);
				float minimumDot = cos(paddedHalfAngle);
				float coneLatitude = asin(clamp(coneDirectionCamera.z, -1.0, 1.0));
				float coneLongitude = atan2(coneDirectionCamera.y, coneDirectionCamera.x);
				if (coneLongitude >= PI)
					coneLongitude -= 2.0 * PI;

				// Bounded C3 query. Latitude differs by no more than spherical angle, so the padded
				// cone bounds a contiguous row interval. One extra row/bin is deliberate tolerance.
				int centerBinY = clamp((int)floor(
					(coneLatitude + 0.5 * PI) / latitudeStep),
					0, NativeGeerInverseGrid.y - 1);
				int latitudeRadiusBins = (int)ceil(paddedHalfAngle / latitudeStep) + 1;
				int minBinY = max(0, centerBinY - latitudeRadiusBins);
				int maxBinY = min(NativeGeerInverseGrid.y - 1,
					centerBinY + latitudeRadiusBins);
				int centerBinX = clamp((int)floor(
					(coneLongitude + PI) / longitudeStep),
					0, NativeGeerInverseGrid.x - 1);
				bool coneTouchesPole = abs(coneLatitude) + paddedHalfAngle >= 0.5 * PI - 1.0e-6;

				uint2 rectMin = uint2(0xffffffffu, 0xffffffffu);
				uint2 rectMax = uint2(0u, 0u);
				uint selectedValidBins = 0u;
				[loop]
				for (int binY = minBinY; binY <= maxBinY; ++binY)
				{
					float latitude = ((float)binY + 0.5) * latitudeStep - 0.5 * PI;
					float cosLatitude = cos(latitude);
					bool enumerateAllLongitudes = coneTouchesPole;
					int longitudeRadiusBins = 0;
					if (!enumerateAllLongitudes)
					{
						float longitudeDenominator = cos(coneLatitude) * cosLatitude;
						if (longitudeDenominator <= 1.0e-8)
						{
							enumerateAllLongitudes = true;
						}
						else
						{
							float minimumLongitudeCos = (minimumDot -
								sin(coneLatitude) * sin(latitude)) / longitudeDenominator;
							if (minimumLongitudeCos > 1.0 + 1.0e-6)
								continue;
							if (minimumLongitudeCos <= -1.0)
							{
								enumerateAllLongitudes = true;
							}
							else
							{
								float longitudeHalfAngle = acos(clamp(
									minimumLongitudeCos, -1.0, 1.0));
								longitudeRadiusBins = (int)ceil(
									longitudeHalfAngle / longitudeStep) + 1;
								enumerateAllLongitudes =
									2 * longitudeRadiusBins + 1 >= NativeGeerInverseGrid.x;
							}
						}
					}

					int longitudeIterations = enumerateAllLongitudes
						? NativeGeerInverseGrid.x : 2 * longitudeRadiusBins + 1;
					[loop]
					for (int longitudeIteration = 0;
						 longitudeIteration < longitudeIterations; ++longitudeIteration)
					{
						int binX = enumerateAllLongitudes
							? longitudeIteration
							: centerBinX + longitudeIteration - longitudeRadiusBins;
						binX = ((binX % NativeGeerInverseGrid.x) +
							NativeGeerInverseGrid.x) % NativeGeerInverseGrid.x;
						float longitude = ((float)binX + 0.5) * longitudeStep - PI;
						float3 binDirectionCamera = float3(
							cosLatitude * cos(longitude),
							cosLatitude * sin(longitude),
							sin(latitude));
						if (dot(coneDirectionCamera, binDirectionCamera) < minimumDot)
							continue;

						uint binIndex = (uint)(binY * NativeGeerInverseGrid.x + binX);
						uint4 binRect = NativeGeerInverseDirection[binIndex];
						if (binRect.x == 0xffffffffu)
							continue;
						rectMin = min(rectMin, binRect.xy);
						rectMax = max(rectMax, binRect.zw);
						selectedValidBins++;
					}
				}

				if (selectedValidBins == 0u || rectMin.x == 0xffffffffu)
				{
					WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
					return;
				}

				// Convert the inclusive pixel rectangle to exact pixel-edge NDC bounds. Output pixels
				// are top-down while clip/NDC y is up, hence the deliberate y reversal.
				float2 outputSize = (float2)NativeGeerOutputSize;
				float left = -1.0 + 2.0 * ((float)rectMin.x / outputSize.x);
				float right = -1.0 + 2.0 * (((float)rectMax.x + 1.0) / outputSize.x);
				float top = 1.0 - 2.0 * ((float)rectMin.y / outputSize.y);
				float bottom = 1.0 - 2.0 * (((float)rectMax.y + 1.0) / outputSize.y);
				float2 rectCenter = 0.5 * float2(left + right, bottom + top);
				float2 rectHalf = 0.5 * float2(right - left, top - bottom);
				if (any(isnan(rectCenter)) || any(isinf(rectCenter)) ||
					any(isnan(rectHalf)) || any(isinf(rectHalf)) || any(rectHalf <= 0.0))
				{
					WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
					return;
				}
				clipPos = float4(rectCenter, 0.5, 1.0);
				axis1 = float2(rectHalf.x, 0.0);
				axis2 = float2(0.0, rectHalf.y);
			}
		}
	}
	else
	{
	// Clamp view position to prevent extreme projections at edge of view
	float tanFovX = (ScreenSize.x * 0.5) / FocalLength.x;
	float tanFovY = (ScreenSize.y * 0.5) / FocalLength.y;
	float limX = 1.3 * tanFovX;
	float limY = 1.3 * tanFovY;
	// The clamp below is an EWA-specific guard on the projection Jacobian. The PBF bound is exact
	// off-axis and would be biased by a moved centre, so it uses the true view position.
	float3 viewPosUnclamped = viewPos.xyz;
	viewPos.x = clamp(viewPos.x / viewPos.z, -limX, limX) * viewPos.z;
	viewPos.y = clamp(viewPos.y / viewPos.z, -limY, limY) * viewPos.z;

	float3x3 viewMat = (float3x3)WorldToView;
	// View-space 3D covariance, shared by the EWA projection and the GEER PBF bound below.
	float3x3 viewCov = CalcCovariance3DView(cov3D_world, viewMat);
	float2x2 cov2D = CalcCovariance2D(viewCov, viewPos.xyz, FocalLength);

	// Decompose to axes
	DecomposeCovariance2D(cov2D, axis1, axis2);

	// Convert to NDC
	axis1 = axis1 / ScreenSize * 4.0;
	axis2 = axis2 / ScreenSize * 4.0;

	// GEER: quad edge is currently ~2.83σ (exp(-4) cutoff). GEER integrates to 3σ and the
	// EWA footprint itself is approximate — inflate to stay conservative (gs.GeerQuadInflation).
	axis1 *= QuadInflation;
	axis2 *= QuadInflation;

	float2 ndcCenter = clipPos.xy / clipPos.w;

	// --- GEER exact footprint: Particle Bounding Frustum (gs.GeerPBF) ---
	// The EWA quad above is sized from the PROJECTED 2D covariance, which is wrong in both
	// directions for GEER: wasteful for some splats, and too SMALL for splats elongated along the
	// view direction, whose density is then guillotined at the quad edge (measured 2026-08-06:
	// arm-1 splat C fills 0.850 of its quad with straight edges, against ~0.79 for a Gaussian
	// ellipse). PBF derives the bound from the 3D covariance instead, so the density falls off
	// inside its own footprint. This CHANGES the image for those splats, and that is the fix.
	bool bPBFRect = false;
	if (UseGeerEval != 0 && UseGeerPBF != 0)
	{
		float2 tanCenter, tanHalfExtent;
		bool bPBFCull;
		bool bPBFOk = ComputePBFPinhole(viewCov, viewPosUnclamped, GeerPBFLambda,
			float2(tanFovX, tanFovY), tanCenter, tanHalfExtent, bPBFCull);
		if (bPBFCull)
		{
			// Camera inside this splat's lambda-sigma ellipsoid. The reference drops these
			// (forward.cu:246-257) and so do we: r = |p|/sigma is ~0 across the whole viewport,
			// so the splat would paint every pixel at its peak alpha. This is the sigma -> large
			// half of the degeneracy gs.GeerNearCull guards at p -> 0.
			WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
			return;
		}
		if (bPBFOk)
		{
			// Tangent bounds -> NDC: ndc = tan / tanFov, with no y flip (view y and NDC y are both
			// up here). Taken as a DELTA against the projected centre so that whatever the
			// projection matrix does to the centre — principal-point offset, near/far, TSR jitter —
			// cancels, and ClipPosition stays the single source of truth for the centre itself.
			float2 invTanFov = float2(1.0 / tanFovX, 1.0 / tanFovY);
			float2 tanSplat = viewPosUnclamped.xy / viewPosUnclamped.z;
			float2 rectCenter = ndcCenter + (tanCenter - tanSplat) * invTanFov;
			float2 rectHalf = tanHalfExtent * invTanFov;

			// Clamp the rect to the viewport rather than collapsing it. Pixels outside NDC [-1,1]
			// are never rasterised, so intersecting with the viewport is lossless — and unlike the
			// binary collapse the EWA path uses below, it cannot pop in and out under sub-pixel
			// camera motion. Close splats and the full-FOV fallback both land here.
			float2 rectMin = max(rectCenter - rectHalf, -1.0);
			float2 rectMax = min(rectCenter + rectHalf,  1.0);
			// Exact off-screen cull, replacing the conservative frustum test on this path. Negated
			// comparisons so a NaN anywhere in the rect culls instead of leaking through.
			if (!(rectMin.x <= rectMax.x) || !(rectMin.y <= rectMax.y))
			{
				WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
				return;
			}
			rectCenter = 0.5 * (rectMin + rectMax);
			rectHalf   = 0.5 * (rectMax - rectMin);

			// Axis-aligned rect: MainVS builds corner.x * Axis1 + corner.y * Axis2.
			axis1 = float2(rectHalf.x, 0.0);
			axis2 = float2(0.0, rectHalf.y);
			pbfNdcOffset = rectCenter - ndcCenter;
			bPBFRect = true;
		}
	}

	if (!bPBFRect)
	{
		// Safety clamp
		float maxAxisSize = 2.0;
		if (any(isnan(axis1)) || any(isinf(axis1)) || length(axis1) > maxAxisSize)
		{
			axis1 = float2(0.01, 0.0);
		}
		if (any(isnan(axis2)) || any(isinf(axis2)) || length(axis2) > maxAxisSize)
		{
			axis2 = float2(0.0, 0.01);
		}

		// Frustum culling
		float2 ndcExtent = abs(axis1) + abs(axis2);
		if (ndcCenter.x - ndcExtent.x > 1.0 || ndcCenter.x + ndcExtent.x < -1.0 ||
			ndcCenter.y - ndcExtent.y > 1.0 || ndcCenter.y + ndcExtent.y < -1.0)
		{
			WriteInvalidSplat(outputIndex, selectedClusterID, selectedLODLevel);
			return;
		}
	}
	}

	// Compute final color
	float3 finalColor;

	if (UseSHRendering && NumSHCoeffs > 0)
	{
		// View-dependent SH rendering
		// Load SH coefficients from buffer (DC + higher-order)
		float3 shDC;
		float3 sh[15];
		LoadSH(SHBuffer, splatIndex, SHBufferCoeffs, NumSHCoeffs, shDC, sh);

		// Compute view direction in world space (FROM splat TO camera)
		float3 viewDirWorld = normalize(CameraPosition - worldPos.xyz);

		// Transform view direction from world space to PLY/SH space
		// Step 1: World to Local (for actor rotation support)
		// For direction vectors, we use transpose of LocalToWorld (inverse for orthonormal rotation)
		float3 viewDirLocal = mul(viewDirWorld, transpose((float3x3)LocalToWorld));

		// Step 2: UE Local to PLY space (hardcoded, no matrix ambiguity)
		// UE: X-forward, Y-right, Z-up
		// PLY: X-right, Y-down, Z-forward
		// Mapping: PLY.X = UE.Y, PLY.Y = -UE.Z, PLY.Z = UE.X
		float3 viewDirPLY = float3(viewDirLocal.y, -viewDirLocal.z, viewDirLocal.x);

		// Negate to convert from splat->camera to camera->splat direction (SH training convention)
		viewDirPLY = -viewDirPLY;

		// Renormalize: LocalToWorld may contain scale, which denormalizes viewDirLocal.
		// SH basis functions require a unit direction vector.
		viewDirPLY = normalize(viewDirPLY);

		// Evaluate spherical harmonics with view direction
		float3 shColor = EvaluateSH(viewDirPLY, shDC, sh, SHOrder);

		// Convert SH result to displayable color (add 0.5 offset)
		// This produces sRGB color values (same as f_dc storage format)
		shColor = 0.5 + shColor;

		// Output sRGB values directly — do NOT convert to linear here.
		// Alpha blending must happen in sRGB space to match 3DGS training.
		// The sRGB→linear conversion is deferred to the composite pass
		// (after all splats are blended in sRGB space).
		finalColor = max(shColor, 0.0);
	}
	else
	{
		// DC-only rendering (use pre-computed color from packed buffer)
		// Output sRGB values directly — linear conversion deferred to composite pass.
		finalColor = colorOpacity.rgb;
	}

	// Store view data
	FGaussianSplatViewData viewData;
	viewData.ClipPosition = clipPos;
	viewData.TranslatedWorldPos = translatedWorldPos;
	viewData.TranslatedWorldPosPad = 0;
	viewData.PackedColorRG = PackHalf2x16(finalColor.rg);
	viewData.PackedColorBA = PackHalf2x16(float2(finalColor.b, opacity));
	viewData.Axis1 = axis1;
	viewData.Axis2 = axis2;
	viewData.ClusterID = selectedClusterID;
	viewData.Padding = selectedLODLevel;
	viewData.SplatNormal = splatNormal;
	viewData.SplatNormalConfidence = splatNormalConfidence;
	viewData.W2ORow0 = w2oRow0;
	viewData.ViewDistance = viewDistance;
	viewData.W2ORow1 = w2oRow1;
	viewData.W2OPad1 = pbfNdcOffset.x;  // PBF rect centre offset from the projected centre (NDC)
	viewData.W2ORow2 = w2oRow2;
	viewData.W2OPad2 = pbfNdcOffset.y;
	ViewDataBuffer[outputIndex] = viewData;
}

[numthreads(256, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint threadIndex = DispatchThreadId.x;

	// COMPACTION MODE: Use pre-compacted visible splat indices
	// This eliminates visibility checks and ensures contiguous output
	if (UseCompaction)
	{
		if (threadIndex >= VisibleSplatCount)
		{
			return;
		}

		// Determine the base offset for writing into ViewDataBuffer.
		uint CompactionGlobalBase = UseGlobalCompactionPath
			? GlobalBaseOffsetsBuffer[ProxyIndex]
			: GlobalBaseOffset;

		// Budget cap: skip writes beyond MaxRenderBudget to prevent OOB access
		if (MaxRenderBudget > 0u && (CompactionGlobalBase + threadIndex) >= MaxRenderBudget)
		{
			return;
		}

		// Read actual splat index from compacted list
		uint splatIndex = CompactedSplatIndices[threadIndex];

		// Get cluster info for debug visualization
		uint clusterIndex = SplatClusterIndexBuffer[splatIndex];
		bool isLODSplat = (splatIndex >= OriginalSplatCount);

		uint selectedClusterID = clusterIndex;
		uint selectedLODLevel = isLODSplat ? 1 : 0;

		if (!isLODSplat)
		{
			uint packedSelected = SelectedClusterBuffer[clusterIndex];
			selectedClusterID = packedSelected & 0x00FFFFFF;
			selectedLODLevel = (packedSelected >> 24) & 0xFF;
		}

		ProcessSplat(splatIndex, CompactionGlobalBase + threadIndex, selectedClusterID, selectedLODLevel);
		return;
	}

	// NON-COMPACTION MODE: Original behavior (process all splats)
	uint splatIndex = threadIndex;
	if (splatIndex >= SplatCount)
	{
		return;
	}

	// UNIFIED APPROACH: Handle both original and LOD splats
	bool isLODSplat = (splatIndex >= OriginalSplatCount);
	uint clusterIndex = 0;
	uint selectedClusterID = 0;
	uint selectedLODLevel = 0;

	if (UseClusterCulling)
	{
		clusterIndex = SplatClusterIndexBuffer[splatIndex];

		if (isLODSplat)
		{
			// LOD splat: check if its parent cluster is selected for LOD rendering
			if (!UseLODRendering || !IsLODClusterSelected(clusterIndex))
			{
				WriteInvalidSplat(GlobalBaseOffset + splatIndex, clusterIndex, 1);
				return;
			}
			selectedClusterID = clusterIndex;
			selectedLODLevel = 1;
		}
		else
		{
			// Original splat: use leaf cluster visibility logic
			uint leafClusterIndex = clusterIndex;

			uint packedSelected = SelectedClusterBuffer[leafClusterIndex];
			selectedClusterID = packedSelected & 0x00FFFFFF;
			selectedLODLevel = (packedSelected >> 24) & 0xFF;

			if (!IsClusterVisible(leafClusterIndex))
			{
				WriteInvalidSplat(GlobalBaseOffset + splatIndex, selectedClusterID, selectedLODLevel);
				return;
			}

			// LOD Rendering: Skip original splats when covered by a parent's LOD representation
			if (UseLODRendering && selectedClusterID != leafClusterIndex)
			{
				WriteInvalidSplat(GlobalBaseOffset + splatIndex, selectedClusterID, selectedLODLevel);
				return;
			}
		}
	}

	ProcessSplat(splatIndex, GlobalBaseOffset + splatIndex, selectedClusterID, selectedLODLevel);
}
