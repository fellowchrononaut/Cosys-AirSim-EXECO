// Composite pass: converts sRGB-blended gaussian splat accumulation to linear
// for proper integration with UE's linear SceneColor buffer.
//
// Gaussian splatting trains and evaluates colors in sRGB space. Alpha blending
// must happen in sRGB space to produce correct results. The splat rendering pass
// writes sRGB premultiplied-alpha colors to an intermediate render target.
// This composite pass un-premultiplies, converts sRGB→linear, optionally applies
// screen-space dynamic lighting (depth-reconstructed normals, up to MAX_LIGHTS lights),
// then applies inverse ACES tonemapping, re-premultiplies, and blends onto SceneColor.

#include "/Engine/Public/Platform.ush"

Texture2D IntermediateTexture;
SamplerState IntermediateSampler;

// Screen-space lighting parameters (bound when LightingBlend > 0)
// DepthAccumTexture (RG32F): .r = sum(viewZ*alpha*T), .g = sum(alpha*T).
// Expected view-space depth = r/g; .g doubles as per-pixel coverage weight.
Texture2D    DepthAccumTexture;
SamplerState DepthAccumSampler;
float4x4 InvViewMatrix;  // view → world (GetInvViewMatrix), row-major UE convention
float2   FocalLength;    // pixels: (ProjM00*W/2, ProjM11*H/2)
float2   ScreenSize;     // ViewRect extent in pixels (Width, Height)
float2   ViewRectMin;    // ViewRect.Min (pixels), for SV_Position → view ray
float3   CameraWorldPos;

// Flattened light arrays — MAX_LIGHTS is defined by the C++ ModifyCompilationEnvironment
float4 LightPositionInvRadius[MAX_LIGHTS]; // xyz = world pos,  w = 1/attenuationRadius
float4 LightColorType[MAX_LIGHTS];         // rgb = tint,       w = type (0=dir,1=point,2=spot)
float4 LightDirectionCosOuter[MAX_LIGHTS]; // xyz = world dir,  w = cosOuter (spot)
float4 LightCosInner[MAX_LIGHTS];          // x   = cosInner,   y = intensity,  zw = pad
uint   NumLights;
float3 AmbientColor;
float  LightingBlend;
float  LightIntensityScale;                // global sensitivity for per-light intensity
float  LightResponseCeiling;                // per-light contribution ceiling (raise past 1 for brighter lights)
float  RelightRatioMin;                     // clamp floor for the brightness-preserving relight ratio
float  RelightRatioMax;                     // clamp ceiling for the brightness-preserving relight ratio
uint   UseRelightRatio;                     // 1 = brightness-preserving ratio (default), 0 = old direct multiply
uint   NormalSmoothRadius;                 // bilateral depth-smoothing kernel radius (px); 0 = off
float  NormalSmoothFrac;                    // depth-similarity sigma as fraction of view depth
uint   NormalSampleStep;                    // central-difference baseline (px) for the normal

// GeometryMode 1: proxy-mesh CustomDepth (clean geometry, no per-splat depth scatter).
// DeviceZ values, linearized with the engine's own DeviceZ->linear-view-Z transform.
Texture2D    CustomDepthTexture;
SamplerState CustomDepthSampler;
float4       InvDeviceZToWorldZTransform;
uint         GeometryMode;                  // 0 = splat depth-accum, 1 = proxy mesh CustomDepth, 2 = per-splat normal

// Diagnostic visualization for the active GeometryMode's reconstructed geometry.
// 0 = off (default), 1 = show the reconstructed normal as an RGB color.
uint         DebugView;

// GeometryMode 2: alpha-weighted per-splat analytic-normal accumulation (RGBA16F).
// .rgb = sum(splatNormal*alpha*T), .a = sum(alpha*T); normal = normalize(rgb / a).
Texture2D    NormalAccumTexture;
SamplerState NormalAccumSampler;

// Attempt to invert UE's ACES filmic tone curve so that display-ready gaussian
// splat colors survive tone mapping unchanged.  Uses the Narkowicz ACES fit
// (same curve UE's default tone mapper approximates) and solves the quadratic
// analytically.  Without this, already-display-ready sRGB colours appear
// over-saturated after the engine applies its S-curve.
float3 InverseACESTonemap(float3 color)
{
	// Narkowicz ACES fit: y = clamp((x*(a*x+b)) / (x*(c*x+d)+e))
	float a = 2.51;
	float b = 0.03;
	float c = 2.43;
	float d = 0.59;
	float e = 0.14;

	// Solve (a - y*c)*t^2 + (b - y*d)*t - y*e = 0  for t (pre-tonemap value)
	color = clamp(color, 0.0, 0.99);  // avoid singularities near 1.0
	float3 A = a - color * c;
	float3 B = b - color * d;
	float3 C = -color * e;

	return (-B + sqrt(max(B * B - 4.0 * A * C, 0.0))) / (2.0 * A);
}

// Reconstruct world-space position at a pixel from the alpha-weighted depth accumulation.
// Returns false if the pixel has no splat coverage (weight ~0). The expected view-space depth
// (linear) is recovered as r/g, then back-projected through the pinhole model (FocalLength)
// to a view-space position, and transformed to world via InvViewMatrix.
// View space: +X right, +Y up, +Z forward; pixel Y increases downward, hence the Y flip.
// Bilateral-smoothed expected view-space depth at a pixel. Averages neighbouring expected
// depths weighted by coverage and depth similarity, which suppresses the per-splat depth
// scatter that otherwise makes reconstructed normals look like a noisy SfM mesh, while the
// depth-similarity term preserves real silhouettes/creases. Returns false if no coverage.
bool SmoothViewZ(int2 pixel, out float outZ)
{
	float2 daC = DepthAccumTexture.Load(int3(pixel, 0)).rg;
	outZ = 0.0;
	if (daC.g <= 1e-6)
	{
		return false;  // no coverage here
	}
	float zC = daC.r / daC.g;

	int R = (int)NormalSmoothRadius;
	if (R <= 0)
	{
		outZ = zC;
		return true;
	}

	float sigma  = max(NormalSmoothFrac * zC, 1e-3);
	float inv2s2 = 1.0 / (2.0 * sigma * sigma);
	float wSum = 0.0;
	float zSum = 0.0;
	[loop]
	for (int dy = -R; dy <= R; ++dy)
	{
		[loop]
		for (int dx = -R; dx <= R; ++dx)
		{
			float2 da = DepthAccumTexture.Load(int3(pixel + int2(dx, dy), 0)).rg;
			if (da.g <= 1e-6) continue;
			float z  = da.r / da.g;
			float dz = z - zC;
			float w  = da.g * exp(-dz * dz * inv2s2);  // coverage * depth-similarity
			wSum += w;
			zSum += z * w;
		}
	}
	outZ = (wSum > 0.0) ? (zSum / wSum) : zC;
	return true;
}

// Shared pinhole back-projection: given a linear view-space depth at a pixel, recover the
// world-space position. Used by both geometry modes — only how viewZ is obtained differs.
float3 ViewZAndPixelToWorld(int2 pixel, float viewZ)
{
	float2 pv = float2(pixel) - ViewRectMin;               // pixel within ViewRect
	float cx = ScreenSize.x * 0.5;
	float cy = ScreenSize.y * 0.5;

	float3 viewPos;
	viewPos.x = (pv.x + 0.5 - cx) * viewZ / FocalLength.x;
	viewPos.y = (cy - pv.y - 0.5) * viewZ / FocalLength.y;  // flip Y (pixel down → view up)
	viewPos.z = viewZ;

	return mul(float4(viewPos, 1.0), InvViewMatrix).xyz;    // row-major UE convention
}

bool ReconstructWorld(int2 pixel, out float3 worldPos)
{
	worldPos = float3(0, 0, 0);
	float viewZ;
	if (!SmoothViewZ(pixel, viewZ))                        // expected (bilateral-smoothed) depth
	{
		return false;  // no coverage here
	}
	worldPos = ViewZAndPixelToWorld(pixel, viewZ);
	return true;
}

// Mirrors the engine's ConvertFromDeviceZ() (Common.ush), using the per-frame transform the
// main view already computed (FSceneView::InvDeviceZToWorldZTransform), since CustomDepth is
// rendered through the same (possibly TAA/TSR-jittered) projection as the main SceneDepth.
float ConvertCustomDeviceZToViewZ(float DeviceZ)
{
	return DeviceZ * InvDeviceZToWorldZTransform.x + InvDeviceZToWorldZTransform.y
		+ 1.0 / (DeviceZ * InvDeviceZToWorldZTransform.z - InvDeviceZToWorldZTransform.w);
}

// GeometryMode 1: reconstruct from the hidden proxy mesh's CustomDepth instead of the splat's
// own (noisy) depth accumulation. DeviceZ == 0 means no CustomDepth geometry at this pixel
// (cleared/dummy texture), so we report no coverage exactly like ReconstructWorld does.
bool ReconstructWorldFromCustomDepth(int2 pixel, out float3 worldPos)
{
	worldPos = float3(0, 0, 0);
	float deviceZ = CustomDepthTexture.Load(int3(pixel, 0)).r;
	if (deviceZ <= 0.0)
	{
		return false;  // no proxy-mesh coverage here
	}
	float viewZ = ConvertCustomDeviceZToViewZ(deviceZ);
	worldPos = ViewZAndPixelToWorld(pixel, viewZ);
	return true;
}

// Dispatches to whichever geometry source GeometryMode selects. Both reconstruction paths feed
// the same downstream normal/lighting code, so callers don't need to know which mode is active.
bool ReconstructWorldAuto(int2 pixel, out float3 worldPos)
{
	if (GeometryMode == 1)
	{
		return ReconstructWorldFromCustomDepth(pixel, worldPos);
	}
	return ReconstructWorld(pixel, worldPos);
}

// GeometryMode 2: recover the alpha-weighted average per-splat analytic normal at a pixel.
// NormalAccumTexture holds sum(splatNormal*alpha*T) in .rgb and sum(alpha*T) in .a (same
// premultiplied-"over" pattern as DepthAccumTexture). Per-splat orientation has real scatter
// (training noise, not just an axis-pick ambiguity), and the single-pixel accumulation only
// averages over the few splats that happened to land in that exact pixel — so it still shows
// speckle. Bilateral-smoothed across neighbouring pixels (same depth-similarity weighting as
// SmoothViewZ, reusing NormalSmoothRadius/NormalSmoothFrac) to average out that scatter, while
// the depth-similarity term keeps silhouettes/creases from blurring together. Returns false
// where there's no coverage.
bool ReconstructNormalFromAccum(int2 pixel, out float3 normal)
{
	normal = float3(0, 0, 1);
	float4 accumC = NormalAccumTexture.Load(int3(pixel, 0));
	if (accumC.a <= 1e-6)
	{
		return false;
	}

	int R = (int)NormalSmoothRadius;
	if (R <= 0)
	{
		normal = normalize(accumC.rgb / accumC.a);
		return true;
	}

	float2 daC = DepthAccumTexture.Load(int3(pixel, 0)).rg;
	float zC = (daC.g > 1e-6) ? (daC.r / daC.g) : 0.0;
	float sigma  = max(NormalSmoothFrac * zC, 1e-3);
	float inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 nSum = float3(0, 0, 0);
	float  wSum = 0.0;
	[loop]
	for (int dy = -R; dy <= R; ++dy)
	{
		[loop]
		for (int dx = -R; dx <= R; ++dx)
		{
			int2 p = pixel + int2(dx, dy);
			float4 accum = NormalAccumTexture.Load(int3(p, 0));
			if (accum.a <= 1e-6) continue;

			float w = accum.a;  // coverage
			if (zC > 0.0)
			{
				float2 da = DepthAccumTexture.Load(int3(p, 0)).rg;
				if (da.g > 1e-6)
				{
					float z  = da.r / da.g;
					float dz = z - zC;
					w *= exp(-dz * dz * inv2s2);  // depth-similarity (preserves edges/creases)
				}
			}
			nSum += (accum.rgb / accum.a) * w;
			wSum += w;
		}
	}

	normal = (wSum > 0.0) ? normalize(nSum / wSum) : normalize(accumC.rgb / accumC.a);
	return true;
}

struct FCompositeVSOutput
{
	float4 Position : SV_POSITION;
};

// Full-screen triangle: 3 vertices cover the entire screen
FCompositeVSOutput MainVS(uint VertexId : SV_VertexID)
{
	FCompositeVSOutput Output;
	float2 UV = float2((VertexId << 1) & 2, VertexId & 2);
	Output.Position = float4(UV * 2.0 - 1.0, 0.0, 1.0);
	return Output;
}

float4 MainPS(FCompositeVSOutput Input) : SV_Target0
{
	// Use SV_Position to load directly from intermediate RT (1:1 pixel mapping)
	// This avoids UV scaling issues when ViewRect != full texture extent
	int2 PixelPos = int2(Input.Position.xy);
	float4 srgbAccum = IntermediateTexture.Load(int3(PixelPos, 0));

	// Early out for fully transparent pixels (no splat contribution)
	if (srgbAccum.a <= 0.0)
	{
		discard;
	}

	// Un-premultiply to recover the actual composited sRGB color
	float3 srgbColor = srgbAccum.rgb / srgbAccum.a;

	// Convert sRGB to linear for UE's SceneColor buffer
	float3 linearColor = pow(max(srgbColor, 0.0), 2.2);

	// Screen-space dynamic lighting — when enabled and lights are present, OR when a debug
	// visualization is requested (DebugView bypasses the per-light loop and tonemap entirely, so
	// it works even with LightingBlend at 0 / no scene lights).
	// Guard: require all three samples to have splat coverage (ReconstructWorld returns false
	// on uncovered pixels) so we don't build normals across silhouette edges.
	if (DebugView != 0 || (LightingBlend > 0.0 && NumLights > 0))
	{
		int2 P = PixelPos;
		float3 N;
		float3 wC;
		bool bHaveGeometry;

		if (GeometryMode == 2)
		{
			// Per-splat analytic normal: no neighbor sampling needed (each splat already carries
			// its own normal), so just read the center pixel's accumulated normal directly, and
			// reuse GeometryMode 0's single-sample position reconstruction (same depth source).
			float3 wCenter;
			bHaveGeometry = ReconstructWorld(P, wCenter) && ReconstructNormalFromAccum(P, N);
			wC = wCenter;
		}
		else
		{
			int  s = max((int)NormalSampleStep, 1);
			// Central differences over a wide baseline: the normal is the surface slope between
			// samples s pixels apart, which averages out per-splat depth waviness (free — no extra taps).
			float3 wL, wR, wD, wU;
			bool okL = ReconstructWorldAuto(P - int2(s, 0), wL);
			bool okR = ReconstructWorldAuto(P + int2(s, 0), wR);
			bool okD = ReconstructWorldAuto(P - int2(0, s), wD);
			bool okU = ReconstructWorldAuto(P + int2(0, s), wU);
			bHaveGeometry = okL && okR && okD && okU;

			// Cross product gives a world-space normal (sign is arbitrary — we use abs NdotL)
			N = normalize(cross(wR - wL, wU - wD));

			// Surface position (for point/spot light vectors + attenuation): average of the
			// four samples ≈ the center pixel's world position, free of an extra reconstruction.
			wC = (wL + wR + wD + wU) * 0.25;
		}

		if (bHaveGeometry)
		{
			if (DebugView == 1)
			{
				// Visualize the reconstructed world-space normal directly as an RGB color
				// (standard normal-map encoding). Bypasses the per-light loop and tonemap
				// entirely so the raw reconstructed data is visible undistorted.
				float3 debugColor = N * 0.5 + 0.5;
				float3 debugPremultiplied = debugColor * srgbAccum.a;
				return float4(debugPremultiplied, srgbAccum.a);
			}

			// lightSum is the actual, orientation-dependent shading. neutralLight is the same
			// lights/attenuation/response evaluated with a fixed "average orientation" NdotL stand-in
			// instead of the real one, giving a baseline brightness this lighting setup would produce
			// regardless of surface facing. Splat RGB is already a baked, lit appearance (not raw
			// albedo) — dividing by this baseline before multiplying keeps that baked brightness
			// mostly intact and only lets through the orientation-driven *variation* (highlight/shadow),
			// instead of double-shading and darkening every pixel by the absolute light level.
			float3 lightSum    = AmbientColor;
			float3 neutralLight = AmbientColor;
			const float NeutralNdl = 0.5;

			[loop]
			for (uint i = 0; i < NumLights; ++i)
			{
				float  type      = LightColorType[i].w;
				float3 tint      = LightColorType[i].rgb;
				float  intensity = LightCosInner[i].y;        // light's brightness (max-comp of HDR color)
				float3 Ldir;     // unit vector from surface toward light source
				float  atten = 1.0;

				if (type < 0.5)  // directional (type == 0)
				{
					// LightDirectionCosOuter.xyz stores the direction the light travels;
					// negate to get the "toward light" vector for NdotL.
					Ldir = -normalize(LightDirectionCosOuter[i].xyz);
				}
				else             // point (type == 1) or spot (type == 2)
				{
					float3 toL = LightPositionInvRadius[i].xyz - wC;
					float  d   = length(toL);
					Ldir = toL / max(d, 1e-4);

					// UE-style smooth distance falloff (inverse-square with smooth edge)
					float invR = LightPositionInvRadius[i].w;
					float x    = saturate(1.0 - (d * invR) * (d * invR) * (d * invR) * (d * invR));
					atten = x * x;

					if (type > 1.5)  // spot cone attenuation (type == 2)
					{
						// dot of spot forward dir with direction FROM surface TO light = -Ldir
						float cosA   = dot(normalize(LightDirectionCosOuter[i].xyz), -Ldir);
						float cosO   = LightDirectionCosOuter[i].w;  // outer cone cosine
						float cosI   = LightCosInner[i].x;           // inner cone cosine
						atten *= saturate((cosA - cosO) / max(cosI - cosO, 1e-3));
					}
				}

				// Two-sided Lambert: splats have no fixed facing, so use abs(NdotL)
				float ndl = abs(dot(N, Ldir));
				// Soft-saturation response: maps [0,inf) intensity -> [0,LightResponseCeiling) so
				// bright lights asymptote instead of hard-clipping. Ceiling > 1 lets strong lights
				// keep getting brighter past the old fixed 1.0 cap; ceiling = 1 reproduces the
				// original behavior. The editor Intensity slider still modulates, especially in
				// the low/mid range.
				float resp = LightResponseCeiling * (1.0 - exp(-intensity * LightIntensityScale));
				lightSum     += tint * (resp * ndl       * atten);
				neutralLight += tint * (resp * NeutralNdl * atten);
			}

			float3 lightTerm;
			if (UseRelightRatio != 0)
			{
				// Ratio of actual to neutral shading — isolates the orientation-driven variation
				// from the absolute light level, then clamps it to a modest range so directional
				// lighting stays visible without washing out or blacking out the splat's own baked
				// appearance.
				lightTerm = clamp(lightSum / max(neutralLight, 1e-4), RelightRatioMin, RelightRatioMax);
			}
			else
			{
				// Original behavior: multiply by the absolute light level directly. Simpler, but
				// double-shades/darkens since the splat's baked color already has some lighting in
				// it — kept as an opt-out for comparison. Clamp avoids HDR blowout, scaling with the
				// response ceiling so raising it doesn't get silently clipped back down.
				lightTerm = min(lightSum, 4.0 * max(LightResponseCeiling, 1.0));
			}

			float3 litLinear = linearColor * lightTerm;
			linearColor = lerp(linearColor, litLinear, LightingBlend);
		}
	}

	// Apply inverse ACES tone curve so that UE's tone mapper maps us back to
	// the intended display color.  Without this, the ACES S-curve boosts
	// saturation and contrast of our already-display-ready splat colours.
	linearColor = InverseACESTonemap(linearColor);

	// Re-premultiply with accumulated alpha
	float3 linearPremultiplied = linearColor * srgbAccum.a;

	// Output: premultiplied linear color with accumulated alpha
	// Blend state: result = src + dst * (1 - srcAlpha)
	return float4(linearPremultiplied, srgbAccum.a);
}
