// Composite pass: converts sRGB-blended gaussian splat accumulation to linear
// for proper integration with UE's linear SceneColor buffer.
//
// Gaussian splatting trains and evaluates colors in sRGB space. Alpha blending
// must happen in sRGB space to produce correct results. The splat rendering pass
// writes sRGB premultiplied-alpha colors to an intermediate render target.
// This composite pass un-premultiplies, converts sRGB→linear, optionally applies
// screen-space dynamic lighting (depth-reconstructed normals, up to MAX_LIGHTS lights),
// then applies inverse ACES tonemapping, re-premultiplies, and blends onto SceneColor.

#include "/Engine/Public/Platform.ush"

Texture2D IntermediateTexture;
SamplerState IntermediateSampler;
uint GeerResidualDebug;

// Screen-space lighting parameters (bound when LightingBlend > 0)
// DepthAccumTexture (RG32F): .r = sum(viewZ*alpha*T), .g = sum(alpha*T).
// Expected view-space depth = r/g; .g doubles as per-pixel coverage weight.
Texture2D    DepthAccumTexture;
SamplerState DepthAccumSampler;
float4x4 InvViewMatrix;  // view → world (GetInvViewMatrix), row-major UE convention
float2   FocalLength;    // pixels: (ProjM00*W/2, ProjM11*H/2)
float2   ScreenSize;     // ViewRect extent in pixels (Width, Height)
float2   ViewRectMin;    // ViewRect.Min (pixels), for SV_Position → view ray
float3   CameraWorldPos;
#if NATIVE_GEER
// Exact AirSim output raymap: six floats per output pixel in Unreal camera axes,
// (origin centimetres, unit direction). This is the same SRV sampled by the native splat PS.
StructuredBuffer<float> NativeGeerRaymap;
int2 NativeGeerRaymapSize;
#endif

// Flattened light arrays — MAX_LIGHTS is defined by the C++ ModifyCompilationEnvironment
float4 LightPositionInvRadius[MAX_LIGHTS]; // xyz = world pos,  w = 1/attenuationRadius
float4 LightColorType[MAX_LIGHTS];         // rgb = tint,       w = type (0=dir,1=point,2=spot)
float4 LightDirectionCosOuter[MAX_LIGHTS]; // xyz = world dir,  w = cosOuter (spot)
float4 LightCosInner[MAX_LIGHTS];          // x   = cosInner,   y = intensity,  zw = pad
uint   NumLights;
float3 AmbientColor;
float  LightingBlend;
float  LightIntensityScale;                // global sensitivity for per-light intensity
float  LightResponseCeiling;                // per-light contribution ceiling (raise past 1 for brighter lights)
float  LightWrap;                           // wrap lighting: ndl_wrapped = (ndl + Wrap) / (1 + Wrap); 0 = off
float  RelightRatioMin;                     // clamp floor for the brightness-preserving relight ratio
float  RelightRatioMax;                     // clamp ceiling for the brightness-preserving relight ratio
uint   UseRelightRatio;                     // 1 = brightness-preserving ratio (default), 0 = old direct multiply
uint   NormalSmoothRadius;                 // bilateral depth-smoothing kernel radius (px); 0 = off
float  NormalSmoothFrac;                    // depth-similarity sigma as fraction of view depth
uint   NormalSampleStep;                    // central-difference baseline (px) for the normal
uint   UseNormalConfidenceFade;             // GeometryMode 0/1: fade lighting by depth-neighbourhood confidence

// GeometryMode 1: proxy-mesh CustomDepth (clean geometry, no per-splat depth scatter).
// DeviceZ values, linearized with the engine's own DeviceZ->linear-view-Z transform.
Texture2D    CustomDepthTexture;
SamplerState CustomDepthSampler;
float4       InvDeviceZToWorldZTransform;
uint         GeometryMode;                  // 0 = splat depth-accum, 1 = proxy mesh CustomDepth, 2 = per-splat normal

// Diagnostic visualization for the active GeometryMode's reconstructed geometry.
// 0 = off (default), 1 = show the reconstructed normal as an RGB color.
uint         DebugView;

// GeometryMode 2: alpha-weighted per-splat analytic-normal accumulation (RGBA16F).
// .rgb = sum(splatNormal*alpha*T), .a = sum(alpha*T); normal = normalize(rgb / a).
Texture2D    NormalAccumTexture;
SamplerState NormalAccumSampler;

// gs.ShadowMode = Proxy Mesh: up to 4 shadow-casting lights' depth captures, fed by
// UNanoGSShadowManagerSubsystem's USceneCaptureComponent2D (SCS_SceneDepth — linear world-unit
// depth in .r, NOT device depth). Named slots since shader parameter structs can't hold an array
// of distinct texture objects. LightShadowSlot[i] maps light i (in the per-light loop below) to
// one of these 4 slots, or -1 for "no shadow." Point lights (cube captures) aren't sampled by
// this 2D-only path yet — ShadowValid is 0 for those, so they're treated as unshadowed.
Texture2D    ShadowDepthTexture0;
SamplerState ShadowDepthSampler0;
Texture2D    ShadowDepthTexture1;
SamplerState ShadowDepthSampler1;
Texture2D    ShadowDepthTexture2;
SamplerState ShadowDepthSampler2;
Texture2D    ShadowDepthTexture3;
SamplerState ShadowDepthSampler3;
float4x4     ShadowViewMatrix[4];     // world -> shadow view space; .z is the linear depth to compare
float4x4     ShadowViewProjMatrix[4]; // world -> shadow clip space; for finding which UV to sample
// Scalar (non-vector) arrays are packed 4-per-vector by SHADER_PARAMETER_SCALAR_ARRAY on the C++
// side (cbuffer alignment) — access elements with GET_SCALAR_ARRAY_ELEMENT, not a plain [] index.
uint4        ShadowValid[1];          // 4 uint32 packed into 1 uint4
int4         LightShadowSlot[(MAX_LIGHTS + 3) / 4]; // MAX_LIGHTS int32 packed 4-per-vector

// Attempt to invert UE's ACES filmic tone curve so that display-ready gaussian
// splat colors survive tone mapping unchanged.  Uses the Narkowicz ACES fit
// (same curve UE's default tone mapper approximates) and solves the quadratic
// analytically.  Without this, already-display-ready sRGB colours appear
// over-saturated after the engine applies its S-curve.
float3 InverseACESTonemap(float3 color)
{
	// Narkowicz ACES fit: y = clamp((x*(a*x+b)) / (x*(c*x+d)+e))
	float a = 2.51;
	float b = 0.03;
	float c = 2.43;
	float d = 0.59;
	float e = 0.14;

	// Solve (a - y*c)*t^2 + (b - y*d)*t - y*e = 0  for t (pre-tonemap value)
	color = clamp(color, 0.0, 0.99);  // avoid singularities near 1.0
	float3 A = a - color * c;
	float3 B = b - color * d;
	float3 C = -color * e;

	return (-B + sqrt(max(B * B - 4.0 * A * C, 0.0))) / (2.0 * A);
}

// Reconstruct world-space position at a pixel from the alpha-weighted depth accumulation.
// Returns false if the pixel has no splat coverage (weight ~0). The expected view-space depth
// (linear) is recovered as r/g, then back-projected through the pinhole model (FocalLength)
// to a view-space position, and transformed to world via InvViewMatrix.
// View space: +X right, +Y up, +Z forward; pixel Y increases downward, hence the Y flip.
// Bilateral-smoothed expected view-space depth at a pixel, plus a [0,1] confidence: how
// consistent the local depth neighbourhood is. A flat, coherent surface has neighbours that
// agree closely (high confidence); a noisy/wrinkly region (the SfM-mesh-like per-splat depth
// scatter) has high local variance (low confidence) — the same role gs.NormalConfidenceFade
// already plays for GeometryMode 2's per-splat axis-pick instability, just measured from depth
// variance instead of splat shape, since this path has no per-splat axis to query. Averages
// neighbouring expected depths weighted by coverage and depth similarity, which suppresses the
// per-splat depth scatter that otherwise makes reconstructed normals look like a noisy SfM mesh,
// while the depth-similarity term preserves real silhouettes/creases. Returns false if no coverage.
bool SmoothViewZ(int2 pixel, out float outZ, out float outConf)
{
	float2 daC = DepthAccumTexture.Load(int3(pixel, 0)).rg;
	outZ = 0.0;
	outConf = 1.0;
	if (daC.g <= 1e-6)
	{
		return false;  // no coverage here
	}
	float zC = daC.r / daC.g;

	int R = (int)NormalSmoothRadius;
	if (R <= 0)
	{
		outZ = zC;
		return true;  // no neighbourhood to measure variance over — assume confident
	}

	float sigma  = max(NormalSmoothFrac * zC, 1e-3);
	float inv2s2 = 1.0 / (2.0 * sigma * sigma);
	float wSum  = 0.0;
	float zSum  = 0.0;
	float zSqSum = 0.0;
	[loop]
	for (int dy = -R; dy <= R; ++dy)
	{
		[loop]
		for (int dx = -R; dx <= R; ++dx)
		{
			float2 da = DepthAccumTexture.Load(int3(pixel + int2(dx, dy), 0)).rg;
			if (da.g <= 1e-6) continue;
			float z  = da.r / da.g;
			float dz = z - zC;
			float w  = da.g * exp(-dz * dz * inv2s2);  // coverage * depth-similarity
			wSum   += w;
			zSum   += z * w;
			zSqSum += z * z * w;
		}
	}
	outZ = (wSum > 0.0) ? (zSum / wSum) : zC;

	if (wSum > 0.0)
	{
		float mean = zSum / wSum;
		float variance = max(zSqSum / wSum - mean * mean, 0.0);
		float stddev = sqrt(variance);
		// Relative to the same sigma used for edge-preserving smoothing: a neighbourhood noisier
		// than that "expected surface roughness" baseline is treated as low confidence.
		outConf = saturate(1.0 - stddev / sigma);
	}
	return true;
}

// Recover a world-space position from the active accumulation contract. Classic rendering uses
// linear view-Z and pinhole back-projection. NativeGEER uses range along the exact selected ray:
// origin + range * direction. Returning false for an invalid native ray keeps invalid-domain
// texels out of normal/lighting reconstruction instead of inventing a pinhole fallback.
bool DepthAndPixelToWorld(int2 pixel, float depth, out float3 worldPos)
{
#if NATIVE_GEER
	worldPos = float3(0, 0, 0);
	int2 rayPixel = pixel - int2(ViewRectMin);
	if (any(rayPixel < int2(0, 0)) || any(rayPixel >= NativeGeerRaymapSize))
	{
		return false;
	}

	uint baseIndex = (uint)(rayPixel.y * NativeGeerRaymapSize.x + rayPixel.x) * 6u;
	float3 originCamera = float3(NativeGeerRaymap[baseIndex + 0u],
	                            NativeGeerRaymap[baseIndex + 1u],
	                            NativeGeerRaymap[baseIndex + 2u]);
	float3 dirCamera = float3(NativeGeerRaymap[baseIndex + 3u],
	                         NativeGeerRaymap[baseIndex + 4u],
	                         NativeGeerRaymap[baseIndex + 5u]);
	if (dot(dirCamera, dirCamera) <= 1e-12)
	{
		return false;
	}

	// AirSim camera axes are +X forward,+Y right,+Z up; UE view axes are right,up,forward.
	float3 originView = float3(originCamera.y, originCamera.z, originCamera.x);
	float3 dirView = float3(dirCamera.y, dirCamera.z, dirCamera.x);
	float3 originWorld = CameraWorldPos + mul(float4(originView, 0.0), InvViewMatrix).xyz;
	float3 dirWorld = mul(float4(dirView, 0.0), InvViewMatrix).xyz;
	worldPos = originWorld + depth * dirWorld;
	return true;
#else
	float2 pv = float2(pixel) - ViewRectMin;               // pixel within ViewRect
	float cx = ScreenSize.x * 0.5;
	float cy = ScreenSize.y * 0.5;

	float3 viewPos;
	viewPos.x = (pv.x + 0.5 - cx) * depth / FocalLength.x;
	viewPos.y = (cy - pv.y - 0.5) * depth / FocalLength.y;  // flip Y (pixel down → view up)
	viewPos.z = depth;

	worldPos = mul(float4(viewPos, 1.0), InvViewMatrix).xyz; // row-major UE convention
	return true;
#endif
}

bool ReconstructWorld(int2 pixel, out float3 worldPos, out float outConf)
{
	worldPos = float3(0, 0, 0);
	float viewZ;
	if (!SmoothViewZ(pixel, viewZ, outConf))               // expected (bilateral-smoothed) depth
	{
		return false;  // no coverage here
	}
	return DepthAndPixelToWorld(pixel, viewZ, worldPos);
}

// Mirrors the engine's ConvertFromDeviceZ() (Common.ush), using the per-frame transform the
// main view already computed (FSceneView::InvDeviceZToWorldZTransform), since CustomDepth is
// rendered through the same (possibly TAA/TSR-jittered) projection as the main SceneDepth.
float ConvertCustomDeviceZToViewZ(float DeviceZ)
{
	return DeviceZ * InvDeviceZToWorldZTransform.x + InvDeviceZToWorldZTransform.y
		+ 1.0 / (DeviceZ * InvDeviceZToWorldZTransform.z - InvDeviceZToWorldZTransform.w);
}

// GeometryMode 1: reconstruct from the hidden proxy mesh's CustomDepth instead of the splat's
// own (noisy) depth accumulation. DeviceZ == 0 means no CustomDepth geometry at this pixel
// (cleared/dummy texture), so we report no coverage exactly like ReconstructWorld does. The
// proxy mesh is already clean geometry (no per-splat depth scatter), so confidence is always 1.
bool ReconstructWorldFromCustomDepth(int2 pixel, out float3 worldPos, out float outConf)
{
	worldPos = float3(0, 0, 0);
	outConf = 1.0;
#if NATIVE_GEER
	// NativeGEER Phase 3c-1 is splat-only and has no UE proxy-mesh output contract.
	return false;
#else
	float deviceZ = CustomDepthTexture.Load(int3(pixel, 0)).r;
	if (deviceZ <= 0.0)
	{
		return false;  // no proxy-mesh coverage here
	}
	float viewZ = ConvertCustomDeviceZToViewZ(deviceZ);
	return DepthAndPixelToWorld(pixel, viewZ, worldPos);
#endif
}

// Dispatches to whichever geometry source GeometryMode selects. Both reconstruction paths feed
// the same downstream normal/lighting code, so callers don't need to know which mode is active.
bool ReconstructWorldAuto(int2 pixel, out float3 worldPos, out float outConf)
{
	if (GeometryMode == 1)
	{
		return ReconstructWorldFromCustomDepth(pixel, worldPos, outConf);
	}
	return ReconstructWorld(pixel, worldPos, outConf);
}

// GeometryMode 2: recover the alpha-weighted average per-splat analytic normal at a pixel.
// NormalAccumTexture holds sum(splatNormal*alpha*T) in .rgb and sum(alpha*T) in .a (same
// premultiplied-"over" pattern as DepthAccumTexture). Per-splat orientation has real scatter
// (training noise, not just an axis-pick ambiguity), and the single-pixel accumulation only
// averages over the few splats that happened to land in that exact pixel — so it still shows
// speckle. Bilateral-smoothed across neighbouring pixels (same depth-similarity weighting as
// SmoothViewZ, reusing NormalSmoothRadius/NormalSmoothFrac) to average out that scatter, while
// the depth-similarity term keeps silhouettes/creases from blurring together.
//
// Neighbour-consistency: each pixel's camera-facing sign heuristic was decided independently at
// splat-write time, so a neighbour can be confidently anti-parallel to the center rather than
// just noisy. Summing it in as-is would partially cancel/bias the average instead of correcting
// it, so each neighbour is flipped to agree with the center pixel's own (unsmoothed) sign before
// it's weighted in — the same "orientation propagation" idea used for PCA normal sign ambiguity,
// just using the center pixel as the local reference instead of building an explicit graph.
// Returns false where there's no coverage.
bool ReconstructNormalFromAccum(int2 pixel, out float3 normal)
{
	normal = float3(0, 0, 1);
	float4 accumC = NormalAccumTexture.Load(int3(pixel, 0));
	if (accumC.a <= 1e-6)
	{
		return false;
	}

	float3 nC = accumC.rgb / accumC.a;  // sign reference for neighbour consistency

	int R = (int)NormalSmoothRadius;
	if (R <= 0)
	{
		normal = normalize(nC);
		return true;
	}

	float2 daC = DepthAccumTexture.Load(int3(pixel, 0)).rg;
	float zC = (daC.g > 1e-6) ? (daC.r / daC.g) : 0.0;
	float sigma  = max(NormalSmoothFrac * zC, 1e-3);
	float inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 nSum = float3(0, 0, 0);
	float  wSum = 0.0;
	[loop]
	for (int dy = -R; dy <= R; ++dy)
	{
		[loop]
		for (int dx = -R; dx <= R; ++dx)
		{
			int2 p = pixel + int2(dx, dy);
			float4 accum = NormalAccumTexture.Load(int3(p, 0));
			if (accum.a <= 1e-6) continue;

			float w = accum.a;  // coverage
			if (zC > 0.0)
			{
				float2 da = DepthAccumTexture.Load(int3(p, 0)).rg;
				if (da.g > 1e-6)
				{
					float z  = da.r / da.g;
					float dz = z - zC;
					w *= exp(-dz * dz * inv2s2);  // depth-similarity (preserves edges/creases)
				}
			}

			float3 nNeighbor = accum.rgb / accum.a;
			if (dot(nNeighbor, nC) < 0.0)
			{
				nNeighbor = -nNeighbor;  // align to local consensus instead of cancelling it out
			}
			nSum += nNeighbor * w;
			wSum += w;
		}
	}

	normal = (wSum > 0.0) ? normalize(nSum / wSum) : normalize(nC);
	return true;
}

// gs.ShadowMode = Proxy Mesh: hard (non-PCF — a future polish item) shadow test against one
// capture's depth texture. ViewMat alone gives view-space Z, the same linear-depth convention
// SCS_SceneDepth writes into the texture (matches it regardless of whether the capture's
// projection is ortho or perspective); ViewProjMat is only used to find which UV to sample.
float SampleShadowAt(Texture2D ShadowTex, SamplerState ShadowSamp, float4x4 ViewMat, float4x4 ViewProjMat, float3 WorldPos)
{
	float4 ViewPos = mul(float4(WorldPos, 1.0), ViewMat);
	float  PixelDepth = ViewPos.z;

	float4 Clip = mul(float4(WorldPos, 1.0), ViewProjMat);
	if (Clip.w <= 0.0)
	{
		return 1.0;  // behind the shadow capture — can't tell, assume unshadowed
	}
	float2 UV = (Clip.xy / Clip.w) * float2(0.5, -0.5) + 0.5;
	if (any(UV < 0.0) || any(UV > 1.0))
	{
		return 1.0;  // outside the capture's frustum — assume unshadowed
	}

	float ShadowDepth = ShadowTex.SampleLevel(ShadowSamp, UV, 0).r;
	if (ShadowDepth <= 0.0)
	{
		return 1.0;  // no occluder geometry rendered at this UV (cleared/background) — unshadowed
	}
	const float ShadowBias = 5.0;  // cm; avoids self-shadowing acne
	return (PixelDepth <= ShadowDepth + ShadowBias) ? 1.0 : 0.0;
}

// Dispatches to whichever of the 4 named shadow-texture slots LightIndex's light was assigned
// (LightShadowSlot), or 1.0 (no shadow) if it has none / its slot isn't valid this frame.
float ComputeShadowFactor(int Slot, float3 WorldPos)
{
	if (Slot == 0 && GET_SCALAR_ARRAY_ELEMENT(ShadowValid, 0) != 0) return SampleShadowAt(ShadowDepthTexture0, ShadowDepthSampler0, ShadowViewMatrix[0], ShadowViewProjMatrix[0], WorldPos);
	if (Slot == 1 && GET_SCALAR_ARRAY_ELEMENT(ShadowValid, 1) != 0) return SampleShadowAt(ShadowDepthTexture1, ShadowDepthSampler1, ShadowViewMatrix[1], ShadowViewProjMatrix[1], WorldPos);
	if (Slot == 2 && GET_SCALAR_ARRAY_ELEMENT(ShadowValid, 2) != 0) return SampleShadowAt(ShadowDepthTexture2, ShadowDepthSampler2, ShadowViewMatrix[2], ShadowViewProjMatrix[2], WorldPos);
	if (Slot == 3 && GET_SCALAR_ARRAY_ELEMENT(ShadowValid, 3) != 0) return SampleShadowAt(ShadowDepthTexture3, ShadowDepthSampler3, ShadowViewMatrix[3], ShadowViewProjMatrix[3], WorldPos);
	return 1.0;
}

struct FCompositeVSOutput
{
	float4 Position : SV_POSITION;
};

// Full-screen triangle: 3 vertices cover the entire screen
FCompositeVSOutput MainVS(uint VertexId : SV_VertexID)
{
	FCompositeVSOutput Output;
	float2 UV = float2((VertexId << 1) & 2, VertexId & 2);
	Output.Position = float4(UV * 2.0 - 1.0, 0.0, 1.0);
	return Output;
}

float4 MainPS(FCompositeVSOutput Input) : SV_Target0
{
	// Use SV_Position to load directly from intermediate RT (1:1 pixel mapping)
	// This avoids UV scaling issues when ViewRect != full texture extent
	int2 PixelPos = int2(Input.Position.xy);
	float4 srgbAccum = IntermediateTexture.Load(int3(PixelPos, 0));

	// Pure diagnostic output: black means zero GEER contribution even when a mesh or sky exists
	// underneath. Modes 1-4 contain additive scalar moments and use a fixed log encoding so dense
	// real checkpoints do not saturate; mode 5 exposes ordinary final opacity directly. Alpha 1
	// makes the full-screen composite replace SceneColor, removing the environment from the test.
	if (GeerResidualDebug != 0)
	{
		float value = (GeerResidualDebug <= 4)
			? saturate(log2(1.0 + max(srgbAccum.r, 0.0)) / 16.0)
			: saturate(srgbAccum.a);
		return float4(value.xxx, 1.0);
	}

	// Early out for fully transparent pixels (no splat contribution)
	if (srgbAccum.a <= 0.0)
	{
		discard;
	}

	// Un-premultiply to recover the actual composited sRGB color
	float3 srgbColor = srgbAccum.rgb / srgbAccum.a;

	// Convert sRGB to linear for UE's SceneColor buffer
	float3 linearColor = pow(max(srgbColor, 0.0), 2.2);

	// Gate D exact diagnostic. Encode the reconstructed position relative to the live camera in
	// UE world axes, with [-10 m,+10 m] mapped to [0,1]. NativeGEER reaches this function through
	// its exact raymap permutation, so an accidental pinhole ray or view-Z accumulator produces a
	// spatially varying error that the CPU oracle can identify. Opaque output removes splat alpha
	// from the measurement; uncovered pixels were already discarded above. Apply the same display
	// preparation as ordinary splat colour so the expected byte encoding survives UE tonemapping.
	if (DebugView == 2)
	{
		float2 depthAccum = DepthAccumTexture.Load(int3(PixelPos, 0)).rg;
		if (depthAccum.g <= 1e-6)
		{
			discard;
		}
		float depth = depthAccum.r / depthAccum.g;
		float3 worldPos;
		if (!DepthAndPixelToWorld(PixelPos, depth, worldPos))
		{
			discard;
		}
		const float PositionScaleCm = 1000.0;
		float3 encodedPosition = saturate(
			0.5 + (worldPos - CameraWorldPos) / (2.0 * PositionScaleCm));
		float3 encodedLinear = pow(encodedPosition, 2.2);
		return float4(InverseACESTonemap(encodedLinear), 1.0);
	}

	// Screen-space dynamic lighting — when enabled and lights are present, OR when a debug
	// visualization is requested (DebugView bypasses the per-light loop and tonemap entirely, so
	// it works even with LightingBlend at 0 / no scene lights).
	// Guard: require all three samples to have splat coverage (ReconstructWorld returns false
	// on uncovered pixels) so we don't build normals across silhouette edges.
	if (DebugView != 0 || (LightingBlend > 0.0 && NumLights > 0))
	{
		int2 P = PixelPos;
		float3 N;
		float3 wC;
		bool bHaveGeometry;
		// [0,1] fade for how much to trust the reconstructed normal at this pixel. GeometryMode 2
		// already bakes its own confidence into NormalAccum's per-splat weighting, so it stays at
		// 1 here; GeometryMode 0/1 derive it from local depth-neighbourhood consistency (see
		// SmoothViewZ) so a noisy/wrinkly region fades toward the unlit splat color instead of
		// shading from an unreliable normal — same intent as gs.NormalConfidenceFade in mode 2,
		// applied to this path's only available signal.
		float geometryConfidence = 1.0;

		if (GeometryMode == 2)
		{
			// Per-splat analytic normal: no neighbor sampling needed (each splat already carries
			// its own normal), so just read the center pixel's accumulated normal directly, and
			// reuse GeometryMode 0's single-sample position reconstruction (same depth source).
			float3 wCenter;
			float posConf;
			bHaveGeometry = ReconstructWorld(P, wCenter, posConf) && ReconstructNormalFromAccum(P, N);
			wC = wCenter;
		}
		else
		{
			int  s = max((int)NormalSampleStep, 1);
			// Central differences over a wide baseline: the normal is the surface slope between
			// samples s pixels apart, which averages out per-splat depth waviness (free — no extra taps).
			float3 wL, wR, wD, wU;
			float confL, confR, confD, confU;
			bool okL = ReconstructWorldAuto(P - int2(s, 0), wL, confL);
			bool okR = ReconstructWorldAuto(P + int2(s, 0), wR, confR);
			bool okD = ReconstructWorldAuto(P - int2(0, s), wD, confD);
			bool okU = ReconstructWorldAuto(P + int2(0, s), wU, confU);
			bHaveGeometry = okL && okR && okD && okU;

			// Cross product gives a world-space normal (sign is arbitrary — we use abs NdotL)
			N = normalize(cross(wR - wL, wU - wD));

			// Surface position (for point/spot light vectors + attenuation): average of the
			// four samples ≈ the center pixel's world position, free of an extra reconstruction.
			wC = (wL + wR + wD + wU) * 0.25;

			if (UseNormalConfidenceFade != 0)
			{
				geometryConfidence = min(min(confL, confR), min(confD, confU));
			}
		}

		if (bHaveGeometry)
		{
			if (DebugView == 1)
			{
				// Visualize the reconstructed world-space normal directly as an RGB color
				// (standard normal-map encoding). Bypasses the per-light loop and tonemap
				// entirely so the raw reconstructed data is visible undistorted.
				float3 debugColor = N * 0.5 + 0.5;
				float3 debugPremultiplied = debugColor * srgbAccum.a;
				return float4(debugPremultiplied, srgbAccum.a);
			}

			// lightSum is the actual, orientation-dependent shading. neutralLight is the same
			// lights/attenuation/response evaluated with a fixed "average orientation" NdotL stand-in
			// instead of the real one, giving a baseline brightness this lighting setup would produce
			// regardless of surface facing. Splat RGB is already a baked, lit appearance (not raw
			// albedo) — dividing by this baseline before multiplying keeps that baked brightness
			// mostly intact and only lets through the orientation-driven *variation* (highlight/shadow),
			// instead of double-shading and darkening every pixel by the absolute light level.
			float3 lightSum    = AmbientColor;
			float3 neutralLight = AmbientColor;
			const float NeutralNdl = 0.5;

			[loop]
			for (uint i = 0; i < NumLights; ++i)
			{
				float  type      = LightColorType[i].w;
				float3 tint      = LightColorType[i].rgb;
				float  intensity = LightCosInner[i].y;        // light's brightness (max-comp of HDR color)
				float3 Ldir;     // unit vector from surface toward light source
				float  atten = 1.0;

				if (type < 0.5)  // directional (type == 0)
				{
					// LightDirectionCosOuter.xyz stores the direction the light travels;
					// negate to get the "toward light" vector for NdotL.
					Ldir = -normalize(LightDirectionCosOuter[i].xyz);
				}
				else             // point (type == 1) or spot (type == 2)
				{
					float3 toL = LightPositionInvRadius[i].xyz - wC;
					float  d   = length(toL);
					Ldir = toL / max(d, 1e-4);

					// UE-style smooth distance falloff (inverse-square with smooth edge)
					float invR = LightPositionInvRadius[i].w;
					float x    = saturate(1.0 - (d * invR) * (d * invR) * (d * invR) * (d * invR));
					atten = x * x;

					if (type > 1.5)  // spot cone attenuation (type == 2)
					{
						// dot of spot forward dir with direction FROM surface TO light = -Ldir
						float cosA   = dot(normalize(LightDirectionCosOuter[i].xyz), -Ldir);
						float cosO   = LightDirectionCosOuter[i].w;  // outer cone cosine
						float cosI   = LightCosInner[i].x;           // inner cone cosine
						atten *= saturate((cosA - cosO) / max(cosI - cosO, 1e-3));
					}
				}

				// Two-sided Lambert: splats have no fixed facing, so use abs(NdotL). Without wrap,
				// this bottoms out at a hard zero exactly at the terminator (N perpendicular to
				// Ldir) and ramps back up on the far side — a symmetric "V" that reads as a stark
				// dark ring/line with bright lobes on both sides, not a smooth fade into shadow.
				// Wrap lighting (Penner/Half-Lambert generalization) lifts that floor so it eases
				// into shadow instead of hard-bottoming, while staying two-sided/sign-robust.
				float ndl = abs(dot(N, Ldir));
				ndl = saturate((ndl + LightWrap) / (1.0 + LightWrap));
				// Soft-saturation response: maps [0,inf) intensity -> [0,LightResponseCeiling) so
				// bright lights asymptote instead of hard-clipping. Ceiling > 1 lets strong lights
				// keep getting brighter past the old fixed 1.0 cap; ceiling = 1 reproduces the
				// original behavior. The editor Intensity slider still modulates, especially in
				// the low/mid range.
				float resp = LightResponseCeiling * (1.0 - exp(-intensity * LightIntensityScale));
				// gs.ShadowMode: occlude this light's contribution only — neutralLight stays
				// unshadowed (it's a fixed baseline, not a real orientation), so a fully-shadowed
				// pixel naturally settles toward RelightRatioMin, same as a back-facing surface.
				float shadow = ComputeShadowFactor(GET_SCALAR_ARRAY_ELEMENT(LightShadowSlot, i), wC);
				lightSum     += tint * (resp * ndl       * atten * shadow);
				neutralLight += tint * (resp * NeutralNdl * atten);
			}

			float3 lightTerm;
			if (UseRelightRatio != 0)
			{
				// Ratio of actual to neutral shading — isolates the orientation-driven variation
				// from the absolute light level, then clamps it to a modest range so directional
				// lighting stays visible without washing out or blacking out the splat's own baked
				// appearance.
				lightTerm = clamp(lightSum / max(neutralLight, 1e-4), RelightRatioMin, RelightRatioMax);
			}
			else
			{
				// Original behavior: multiply by the absolute light level directly. Simpler, but
				// double-shades/darkens since the splat's baked color already has some lighting in
				// it — kept as an opt-out for comparison. Clamp avoids HDR blowout, scaling with the
				// response ceiling so raising it doesn't get silently clipped back down.
				lightTerm = min(lightSum, 4.0 * max(LightResponseCeiling, 1.0));
			}

			float3 litLinear = linearColor * lightTerm;
			linearColor = lerp(linearColor, litLinear, LightingBlend * geometryConfidence);
		}
	}

	// Apply inverse ACES tone curve so that UE's tone mapper maps us back to
	// the intended display color.  Without this, the ACES S-curve boosts
	// saturation and contrast of our already-display-ready splat colours.
	linearColor = InverseACESTonemap(linearColor);

	// Re-premultiply with accumulated alpha
	float3 linearPremultiplied = linearColor * srgbAccum.a;

	// Output: premultiplied linear color with accumulated alpha
	// Blend state: result = src + dst * (1 - srcAlpha)
	return float4(linearPremultiplied, srgbAccum.a);
}
