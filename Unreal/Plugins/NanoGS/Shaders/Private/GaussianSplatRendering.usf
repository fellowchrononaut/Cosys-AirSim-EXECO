// Copyright Epic Games, Inc. All Rights Reserved.
// Shader version: 5 (Nanite-style velocity: use clip positions for both current/previous, no SV_Position conversion)

//RASTERIZATION, Vertex Shader + Pixel Shader

// NOTE: We intentionally do NOT include Common.ush here to avoid bringing in
// InstancedStereo.ush which declares InstancedView uniform buffer that we don't bind.
// Instead, we include only what we need.
#include "/Engine/Public/Platform.ush"
#include "/Plugin/NanoGS/Private/GaussianDataTypes.ush"

// Velocity encoding matching UE5's Common.ush EncodeVelocityToTexture
// Velocity is in NDC space [-2, 2] range, encoded to [0, 1] for texture
// Uses 0.499f to avoid using the full range so that (0,0) clear color is special
float4 EncodeVelocityToTexture(float3 V)
{
	// Gamma encoding for better precision in low velocity ranges (matches VELOCITY_ENCODE_GAMMA)
	V.xy = sign(V.xy) * sqrt(abs(V.xy)) * (2.0 / sqrt(2.0));

	// 0.499f is a value smaller than 0.5f to avoid using the full range
	// 0.5f to allow for a range of -2..2 instead of -1..1
	float4 EncodedV;
	EncodedV.xy = V.xy * (0.499f * 0.5f) + 32767.0f / 65535.0f;

	// Depth velocity encoding (not used for TAA/TSR, but included for completeness)
	EncodedV.z = V.z * (0.499f * 0.5f) + 32767.0f / 65535.0f;
	EncodedV.w = 0.0f;  // No pixel animation flag

	return EncodedV;
}

// Vertex shader parameters
#if VERTEXSHADER
StructuredBuffer<FGaussianSplatViewData> ViewDataBuffer;
StructuredBuffer<uint> SortKeysBuffer;
uint SplatCount;
uint DebugMode;  // 0=off, 1=cluster colors (Nanite-style debug view)
uint EnableNanite;  // 1=Nanite enabled, 0=disabled (non-Nanite assets hidden in debug mode)
// GEER PBF footprint (gs.GeerPBF): the exact rect's centre is generally NOT the projected splat
// centre, so CalcViewData stores the NDC offset in W2OPad1/W2OPad2 and it is added here. Global
// kill-switch only; which splats take it is decided per splat by their W2O rows (zero otherwise).
uint UseGeerPBF;
#endif

// Pixel shader parameters for velocity calculation
// NOTE: All matrices are UN-JITTERED to ensure stable velocity when camera is static
#if PIXELSHADER
float4x4 PrevTranslatedWorldToClip;  // Previous frame's un-jittered matrix for velocity
float3 PreViewTranslation;           // Current frame's pre-view translation
float3 PrevPreViewTranslation;       // Previous frame's pre-view translation
uint   UseNormalConfidenceFade;      // GeometryMode 2: weight NormalAccum by per-splat confidence
// Depth-proximity weighting (gs.DepthProximityWeighting): bound only on the second, normal-only
// re-rasterization pass, after DepthAccum from the first pass is fully resolved. Weights each
// splat's normal contribution by how close its own depth (ViewZ below) is to the now-known
// reconstructed surface depth at that pixel — suppresses background/secondary splats visible
// through a semi-transparent foreground splat from polluting the average with a stable-but-wrong
// orientation. Texture2D is bound to a harmless dummy and the flag left 0 on the normal pass's
// first/combined-pass use, so this branch is inert there.
Texture2D    CompletedDepthAccumTexture;
SamplerState CompletedDepthAccumSampler;
uint         UseDepthProximityWeight;
float        DepthProximitySigma;
// GEER exact ray evaluation — mirrors the composite pass's ray reconstruction.
// UseGeerEval is the global kill-switch (gs.GeerEval != 0); which splats actually take the
// GEER path is decided per splat by their W2O rows (zero for classic assets).
uint      UseGeerEval;
float4x4  InvViewMatrix;               // view -> world (GetInvViewMatrix)
float2    FocalLength;                 // pixels: (ProjM00*W/2, ProjM11*H/2)
float2    ScreenSize;                  // ViewRect extent (pixels)
float2    ViewRectMin;                 // ViewRect.Min (viewport == ViewRect on all splat passes)
float3    CameraTranslatedWorldPos;    // ViewOrigin + PreViewTranslation
float     GeerPowerCutoff;             // -0.5*cutoff^2 (cutoff in sigma); 0 = no cutoff
uint      GeerDebugView;               // 1 = visualise canonical radius instead of shading
uint      GeerResidualDebug;            // 1..5 = per-face coverage/evaluation diagnostics

// ADR-001: a viewing ray is (origin, direction), never a direction alone.
// Phase 1: Origin is the uniform camera position. Later phases may vary it per pixel
// (rolling shutter, non-central lenses) — callers must not assume it is uniform.
struct FSplatRay { float3 Origin; float3 Dir; };

// Reconstruct this pixel's viewing ray. Mirrors the composite pass
// (GaussianSplatComposite.usf, ViewZAndPixelToWorld), except SvPosition already carries the
// half-pixel centre offset, so there is no +0.5 here. Dir is NOT normalised: the GEER density
// |d_obj x p_obj|^2 / |d_obj|^2 is scale-invariant in d, so normalising would be wasted work.
FSplatRay GetPixelRay(float2 SvPosition)
{
	float2 pv = SvPosition - ViewRectMin;
	float cx = ScreenSize.x * 0.5;
	float cy = ScreenSize.y * 0.5;
	float3 dView = float3((pv.x - cx) / FocalLength.x,
	                      (cy - pv.y) / FocalLength.y,   // pixel down -> view up
	                      1.0);

	FSplatRay Ray;
	Ray.Origin = CameraTranslatedWorldPos;
	Ray.Dir = mul(float4(dView, 0.0), InvViewMatrix).xyz;
	return Ray;
}
#endif

// Convert HSV to RGB (Nanite-style saturated colors)
float3 HSVToRGB(float3 hsv)
{
	float h = hsv.x;
	float s = hsv.y;
	float v = hsv.z;

	float c = v * s;
	float x = c * (1.0 - abs(fmod(h * 6.0, 2.0) - 1.0));
	float m = v - c;

	float3 rgb;
	if (h < 1.0/6.0)      rgb = float3(c, x, 0);
	else if (h < 2.0/6.0) rgb = float3(x, c, 0);
	else if (h < 3.0/6.0) rgb = float3(0, c, x);
	else if (h < 4.0/6.0) rgb = float3(0, x, c);
	else if (h < 5.0/6.0) rgb = float3(x, 0, c);
	else                  rgb = float3(c, 0, x);

	return rgb + m;
}

// Hash function to generate pseudo-random color from cluster ID
// Uses Nanite-style approach: saturated colors via HSV
float3 HashToColor(uint id)
{
	// Use multiple primes for better distribution
	uint h = id;
	h = h * 2654435761u;  // Knuth multiplicative hash
	h ^= h >> 16;
	h *= 0x85ebca6b;
	h ^= h >> 13;

	// Generate HSV with pastel colors similar to Nanite debug visualization
	// Colors go through sRGB→linear composite (pow 2.2), so use higher brightness to compensate
	float hue = float(h & 0xFFFF) / 65535.0;  // Full hue range
	float sat = 0.25 + 0.35 * float((h >> 16) & 0xFF) / 255.0;  // 0.25-0.60 saturation (pastel)
	float val = 0.75 + 0.25 * float((h >> 24) & 0xFF) / 255.0;  // 0.75-1.0 value (bright)

	return HSVToRGB(float3(hue, sat, val));
}

// Vertex shader output / Pixel shader input
struct FVertexOutput
{
	float4 Position : SV_POSITION;
	float2 LocalPos : TEXCOORD0;
	float4 Color : TEXCOORD1;
	uint DebugFlag : TEXCOORD2;  // 0=normal, 1=debug mode (skip Gaussian)
	float3 TranslatedWorldPos : TEXCOORD3;  // For velocity calculation in pixel shader
	float4 CenterClipPos : TEXCOORD4;       // Splat center clip position for velocity (Nanite-style)
	float4 SplatNormal : TEXCOORD5;         // xyz = analytic per-splat normal (world space), w = confidence [0,1]
	nointerpolation float3 W2ORow0 : TEXCOORD6;  // GEER canonical transform rows (gs.GeerEval)
	nointerpolation float3 W2ORow1 : TEXCOORD7;
	nointerpolation float3 W2ORow2 : TEXCOORD8;
	// DIAGNOSTIC (gs.GeerDebugView 2/3): .x = the sort KEY this splat carries (ViewDistance, cm),
	// .y = the sort RESULT (its position in the sorted draw order, 0..1). Painting them
	// separately is what distinguishes "the key value is wrong" from "the key is fine but the
	// order coming out is wrong" — see NEXT-SESSION.md.
	nointerpolation float2 SortDebug : TEXCOORD9;
};

// Pixel shader output with velocity for TAA/TSR
struct FPixelOutput
{
	float4 Color : SV_Target0;
	float4 Velocity : SV_Target1;
#if OUTPUT_DEPTH
	// Alpha-weighted view-space depth accumulation for screen-space lighting.
	// RG32F target: .r = viewZ * alpha, .g = alpha. The .a output is the blend factor
	// (premultiplied "over"), so the buffer composites to .r = sum(viewZ*alpha*T),
	// .g = sum(alpha*T); expected depth = r/g. Same weights as the color blend.
	float4 DepthAccum : SV_Target2;
#endif
#if OUTPUT_NORMAL
	// Alpha-weighted analytic-normal accumulation for GeometryMode 2.
	// .rgb = splatNormal * alpha, .a = alpha; composite recovers normalize(rgb / a).
	// GeometryMode 2 reuses GeometryMode 0's depth accumulation for world-position reconstruction
	// (only the normal source changes), so OUTPUT_DEPTH and OUTPUT_NORMAL are BOTH active together
	// for that mode — NormalAccum lands at SV_Target3, right after DepthAccum.
#if OUTPUT_DEPTH
	float4 NormalAccum : SV_Target3;
#else
	float4 NormalAccum : SV_Target2;
#endif
#endif
};

// Vertex shader: generate quad from instance data
FVertexOutput MainVS(
	uint VertexId : SV_VertexID,
	uint InstanceId : SV_InstanceID)
{
	FVertexOutput Output;

	// Quad corners based on vertex ID:
	// 0=(-1,-1), 1=(1,-1), 2=(-1,1), 3=(1,1)
	float2 corner;
	corner.x = (VertexId & 1) ? 1.0 : -1.0;
	corner.y = (VertexId & 2) ? 1.0 : -1.0;

	// Get sorted splat index
	uint splatIndex = SortKeysBuffer[InstanceId];
	FGaussianSplatViewData viewData = ViewDataBuffer[splatIndex];

	// Default: normal rendering mode
	Output.DebugFlag = 0;
	Output.TranslatedWorldPos = viewData.TranslatedWorldPos;
	Output.CenterClipPos = viewData.ClipPosition;
	Output.SplatNormal = float4(viewData.SplatNormal, viewData.SplatNormalConfidence);
	Output.W2ORow0 = viewData.W2ORow0;
	Output.W2ORow1 = viewData.W2ORow1;
	Output.W2ORow2 = viewData.W2ORow2;
	// Diagnostic: the key this splat carries, and where the sort actually put it.
	Output.SortDebug = float2(viewData.ViewDistance,
		(SplatCount > 0) ? ((float)InstanceId / (float)SplatCount) : 0.0);

	// Check validity (w <= 0 means invalid/behind camera)
	if (viewData.ClipPosition.w <= 0.0)
	{
		// Output degenerate triangle
		Output.Position = float4(0, 0, 0, 1);
		Output.LocalPos = float2(0, 0);
		Output.Color = float4(0, 0, 0, 0);
		Output.TranslatedWorldPos = float3(0, 0, 0);
		Output.CenterClipPos = float4(0, 0, 0, 1);
		Output.SplatNormal = float4(0, 0, 0, 0);
		Output.SortDebug = float2(0, 0);
		return Output;
	}

	// NDC position of splat center
	float2 ndc = viewData.ClipPosition.xy / viewData.ClipPosition.w;

	// GEER PBF footprint: shift the QUAD to the exact rect's centre. Per-splat gate on nonzero W2O
	// rows — the same discriminator the pixel shader uses — so classic assets are untouched even
	// when a GEER asset is in the same draw. ClipPosition itself is deliberately not moved:
	// velocity (CenterClipPos) and depth must keep using the true splat centre.
	if (UseGeerPBF != 0 && dot(viewData.W2ORow0, viewData.W2ORow0) > 0.0)
	{
		ndc += float2(viewData.W2OPad1, viewData.W2OPad2);
	}

	// Use covariance-based axes for quad offset
	float2 offset = corner.x * viewData.Axis1 + corner.y * viewData.Axis2;

	// Unpack color
	float2 rg = UnpackHalf2x16(viewData.PackedColorRG);
	float2 ba = UnpackHalf2x16(viewData.PackedColorBA);
	float4 color = float4(rg.x, rg.y, ba.x, ba.y);

	// Debug mode: override color with cluster-based coloring (Nanite-style)
	// Only show debug visualization for Nanite-enabled assets; non-Nanite assets are not rendered
	if (DebugMode == 1)
	{
		if (EnableNanite == 1)
		{
			// Show cluster colors - each cluster gets a unique random color
			// Use opaque rendering for clear debug visualization (like Nanite)
			color.rgb = HashToColor(viewData.ClusterID);
			color.a = 1.0;  // Fully opaque for solid colors
			Output.DebugFlag = 1;  // Skip Gaussian falloff in pixel shader
		}
		else
		{
			// Non-Nanite asset: don't render (background is already cleared to black)
			Output.Position = float4(0, 0, 0, 1);
			Output.LocalPos = float2(0, 0);
			Output.Color = float4(0, 0, 0, 0);
			Output.SortDebug = float2(0, 0);
			return Output;
		}
	}

	Output.Color = color;

	// Final clip position
	Output.Position = float4(
		(ndc + offset) * viewData.ClipPosition.w,
		viewData.ClipPosition.z,
		viewData.ClipPosition.w
	);

	Output.LocalPos = corner;

	return Output;
}

// Pixel shader: Gaussian falloff with alpha blending + velocity output (Nanite-style)
FPixelOutput MainPS(FVertexOutput Input)
{
	FPixelOutput Output;
	float4 color = Input.Color;

	// Calculate velocity for TAA/TSR reprojection
	// IMPORTANT: Both current and previous clip positions use UN-JITTERED projection matrices.
	// This ensures velocity is stable when camera is static (we skip CalcViewData recomputation
	// when camera doesn't move, so jittered positions would cause velocity errors).

	// Current NDC from the splat center's clip position (computed with un-jittered matrix)
	float2 CurrentNDC = Input.CenterClipPos.xy / Input.CenterClipPos.w;

	// Previous frame: convert TranslatedWorldPos to previous frame's translated world space
	float3 WorldPos = Input.TranslatedWorldPos - PreViewTranslation;
	float3 PrevTranslatedWorldPos = WorldPos + PrevPreViewTranslation;
	float4 PrevClipPos = mul(float4(PrevTranslatedWorldPos, 1.0), PrevTranslatedWorldToClip);
	float2 PrevNDC = PrevClipPos.xy / PrevClipPos.w;

	// No jitter subtraction needed - both matrices are un-jittered

	// Compute velocity in NDC space (current - previous position)
	float CurrentDeviceZ = Input.CenterClipPos.z / Input.CenterClipPos.w;
	float PrevDeviceZ = PrevClipPos.z / PrevClipPos.w;
	float3 Velocity = float3(CurrentNDC - PrevNDC, CurrentDeviceZ - PrevDeviceZ);

	// Debug mode: solid opaque colors without Gaussian falloff (Nanite-style)
	if (Input.DebugFlag != 0)
	{
		// Simple circle cutoff for cleaner debug visualization
		float distSq = dot(Input.LocalPos, Input.LocalPos);
		if (distSq > 1.0)
		{
			discard;
		}
		// Output solid color (no premultiplied alpha, no Gaussian)
		Output.Color = color;
		Output.Velocity = EncodeVelocityToTexture(Velocity);
	#if OUTPUT_DEPTH
		// No meaningful surface depth in debug viz; contribute nothing.
		Output.DepthAccum = float4(0, 0, 0, 0);
	#endif
	#if OUTPUT_NORMAL
		// No meaningful normal in debug viz; contribute nothing.
		Output.NormalAccum = float4(0, 0, 0, 0);
	#endif
		return Output;
	}

	float distSq = dot(Input.LocalPos, Input.LocalPos);
	bool isGeerSplat = UseGeerEval != 0 && dot(Input.W2ORow0, Input.W2ORow0) > 0.0;
	// Residual diagnostics deliberately exclude classic splats. They answer whether the GEER
	// population presented to two adjacent cube faces, and its exact-ray alpha, agree.
	if (GeerResidualDebug != 0 && !isGeerSplat)
	{
		discard;
	}

	// Per-splat mode: GEER splats carry nonzero W2O rows (row magnitude = 1/sigmaEff > 0);
	// classic-asset splats have exactly zero rows and take the legacy branch below unchanged.
	// UseGeerEval (gs.GeerEval != 0) is only the global kill-switch.
	if (isGeerSplat)
	{
		// 3DGEER exact per-ray evaluation (forward.cu renderCUDA ~1089-1101):
		// peak Gaussian density along this pixel's ray, in canonical splat space.
		FSplatRay Ray = GetPixelRay(Input.Position.xy);
		// p = camera -> splat CENTER (cm); constant across the quad.
		float3 p = Input.TranslatedWorldPos - Ray.Origin;
		float3 pObj = float3(dot(p, Input.W2ORow0), dot(p, Input.W2ORow1), dot(p, Input.W2ORow2));
		float3 dObj = float3(dot(Ray.Dir, Input.W2ORow0), dot(Ray.Dir, Input.W2ORow1), dot(Ray.Dir, Input.W2ORow2));
		float3 nrm = cross(dObj, pObj);
		float power = -0.5 * dot(nrm, nrm) / dot(dObj, dObj);
		bool powerValid = power <= 0.0; // false for NaN and +Inf; matches the normal GEER guard
		bool cutoffPass = powerValid && !(GeerPowerCutoff < 0.0 && power < GeerPowerCutoff);
		float evaluatedAlpha = powerValid ? min(0.99, color.a * exp(power)) : 0.0;
		bool alphaPass = cutoffPass && evaluatedAlpha >= (1.0 / 255.0);

		// Modes 1-4 use additive RT0 blending selected by the C++ draw path. Keeping the stages
		// separate makes the first divergent gate visible: footprint -> cutoff -> alpha threshold
		// -> evaluated weight. Output zero rather than discard for failed stages so the definition
		// of each mode stays explicit. Other MRTs contribute nothing in this diagnostic pass.
		if (GeerResidualDebug >= 1 && GeerResidualDebug <= 4)
		{
			float metric = 0.0;
			if (GeerResidualDebug == 1) metric = 1.0;
			else if (GeerResidualDebug == 2) metric = cutoffPass ? 1.0 : 0.0;
			else if (GeerResidualDebug == 3) metric = alphaPass ? 1.0 : 0.0;
			else metric = alphaPass ? evaluatedAlpha : 0.0;

			Output.Color = float4(metric, metric, metric, metric);
			Output.Velocity = EncodeVelocityToTexture(Velocity);
		#if OUTPUT_DEPTH
			Output.DepthAccum = float4(0, 0, 0, 0);
		#endif
		#if OUTPUT_NORMAL
			Output.NormalAccum = float4(0, 0, 0, 0);
		#endif
			return Output;
		}
		// 3-sigma cutoff (gs.GeerCutoff). The reference bounds EVERY Gaussian at `cutoff` sigma
		// and culls rays outside those bounds before shading (forward.cu:882, and the tan-bounds
		// test in renderCUDA) — in all association modes, PBF and EWA alike. Without it the
		// exp() tail is shaded over the whole quad with a nonzero pedestal at the edge, where
		// the legacy falloff reached exactly zero; across millions of overlapping splats that
		// accumulates into a milky, order-dependent wash. Applied per ray, so it is independent
		// of the footprint's shape and stays correct when Phase 2 swaps the quad for a PBF rect.
		if (!cutoffPass)
		{
			discard;
		}
		// gs.GeerDebugView 1: paint the canonical radius instead of shading, so the density
		// field's iso-contours are directly measurable in pixels. Opaque, because this is
		// meant for the single-splat analytic scene where nothing should blend over it.
		// gs.GeerDebugView 2: the sort KEY (ViewDistance, cm, normalised over 10 m).
		// gs.GeerDebugView 3: the sort RESULT (draw position 0..1).
		// Both should read as a smooth depth ramp. If 2 is smooth and 3 is noise the key is
		// right and the sort is not; if 2 is already noise, the key value itself is wrong.
		if (GeerDebugView == 2 || GeerDebugView == 3)
		{
			float t = (GeerDebugView == 2) ? saturate(Input.SortDebug.x / 1000.0)
			                               : saturate(Input.SortDebug.y);
			color.rgb = float3(t, saturate(1.0 - abs(t - 0.5) * 4.0), 1.0 - t);
			color.a = 1.0;
		}
		else if (GeerDebugView == 1)
		{
			float r = sqrt(max(-2.0 * power, 0.0));
			color.rgb = float3(
				saturate(r / 3.0),                        // red ramps 0..3 sigma
				saturate(1.0 - abs(r - 1.0) * 6.0),       // green ring exactly at r = 1 sigma
				saturate(1.0 - abs(r - 2.0) * 6.0));      // blue ring exactly at r = 2 sigma
			color.a = 1.0;
		}
		else
		{
			// The reference SKIPS a Gaussian when power_mah > 0 (forward.cu:1094 `continue`).
			// Clamping to exp(0) instead would hand a numerically degenerate splat FULL peak
			// alpha — the opposite behaviour. Mathematically power <= 0 always (both terms of
			// -0.5*|n|^2/|d|^2 are non-negative), so this only fires on NaN/Inf, but match the
			// reference rather than invert it.
			// No unit-circle discard on this path: the quad is only a footprint (and Phase 2's
			// PBF rects must not be cut to a circle). The 1/255 alpha discard below remains.
			color.a = evaluatedAlpha;
		}
	}
	else
	{
		// Legacy SuperSplat-style normalized falloff (unchanged)
		// Shifts and rescales exp(-4*A) so it reaches exactly 0.0 at the quad edge,
		// eliminating the visible discontinuity from a nonzero cutoff

		// Discard pixels outside the unit circle for efficiency
		if (distSq > 1.0)
		{
			discard;
		}

		static const float EXP4 = exp(-4.0);           // ≈ 0.0183
		static const float INV_EXP4 = 1.0 / (1.0 - EXP4); // normalization factor
		float gaussianWeight = (exp(-4.0 * distSq) - EXP4) * INV_EXP4;

		// Apply Gaussian to alpha
		color.a = saturate(gaussianWeight * color.a);
	}

	// Premultiplied alpha
	color.rgb *= color.a;

	// Discard nearly transparent pixels for efficiency
	// Match Unity's threshold: 1/255 ≈ 0.00392
	if (color.a < 1.0/255.0)
	{
		discard;
	}

	Output.Color = color;
	// Output velocity for TAA/TSR (Nanite-style encoding)
	Output.Velocity = EncodeVelocityToTexture(Velocity);
	// CenterClipPos.w is the splat center's linear view-space depth (clip.w under UE projection).
	// Needed by OUTPUT_DEPTH (to accumulate it) and by OUTPUT_NORMAL's depth-proximity weighting
	// (to compare it against the already-resolved surface depth), so compute it unconditionally.
	float ViewZ = Input.CenterClipPos.w;
#if OUTPUT_DEPTH
	// Accumulate alpha-weighted view-space depth. color.a is the post-Gaussian per-fragment alpha
	// (same weight the color blend uses). The .a output drives the premultiplied "over" blend
	// factor on RT2.
	Output.DepthAccum = float4(ViewZ * color.a, color.a, 0.0, color.a);
#endif
#if OUTPUT_NORMAL
	// Accumulate alpha-weighted analytic normal (GeometryMode 2), same premultiplied-"over"
	// pattern as DepthAccum above: composite recovers normalize(sum(N*w*T) / sum(w*T)).
	// When UseNormalConfidenceFade is set, w = alpha * confidence instead of just alpha, so
	// splats with an unreliable (near-isotropic) thinnest-axis pick contribute less to the
	// average normal — and pixels where every contributing splat is low-confidence end up with
	// a near-zero total weight, which the composite pass already treats as "no coverage" and
	// fades back to the unlit splat color instead of trusting a noisy normal.
	float normalWeight = color.a * ((UseNormalConfidenceFade != 0) ? Input.SplatNormal.w : 1.0);
	if (UseDepthProximityWeight != 0)
	{
		// Second-pass-only: DepthAccum from the first pass is now fully resolved, so we know the
		// pixel's actual reconstructed surface depth. Splats far from it (e.g. a background splat
		// peeking through a semi-transparent foreground one) get down-weighted instead of
		// confidently contributing a normal that belongs to the wrong surface.
		float2 da = CompletedDepthAccumTexture.Load(int3((int2)Input.Position.xy, 0)).rg;
		if (da.g > 1e-6)
		{
			float surfaceZ = da.r / da.g;
			float dz = ViewZ - surfaceZ;
			float sigma = max(DepthProximitySigma * surfaceZ, 1e-3);
			normalWeight *= exp(-dz * dz / (2.0 * sigma * sigma));
		}
		else
		{
			normalWeight = 0.0;  // no resolved surface here — nothing to compare against, don't trust it
		}
	}
	Output.NormalAccum = float4(Input.SplatNormal.xyz * normalWeight, normalWeight);
#endif
	return Output;
}
